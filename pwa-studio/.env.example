# ============================================
# AWA Motos — PWA Studio Environment Variables
# ============================================

# Magento Backend (MagentoGraphQL endpoint)
MAGENTO_BACKEND_URL=https://awamotos.com

# GraphQL endpoint (auto-detected from MAGENTO_BACKEND_URL/graphql)
GRAPHQL_ENDPOINT=

# Store code (default: awa_motos_br)
STORE_VIEW_CODE=awa_motos_br

# Site code (default: base)
SITE_CODE=base

# Media backend URL (CDN)
IMAGE_RESIZING_URL=
MAGE_MEDIA_PATH_PATTERN=/media/catalog/product/

# PWA-specific
PWA_STUDIO_PORTS_STYLE=integrated
PWA_USE_LIGHTNINGCSS=false
GENERATE_PWA_META=
PWA_PRECACHE=false

# Checkout
CHECKOUT_BRAINTREE_TOKEN=
PWA_CHECKOUT_USE_NEW_FLOW=true

# Analytics (opcional)
GOOGLE_ANALYTICS_API_KEY=

# Build optimization
NODE_ENV=production
ENABLE_BUILD_OPTIMIZATION=true
