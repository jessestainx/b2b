<?php
/**
 * Quick View gallery — Swiper thumbnails (AWA override).
 *
 * @var $block \Magento\Catalog\Block\Product\View\Gallery
 */
declare(strict_types=1);

// @codingStandardsIgnoreFile

$images = $block->getGalleryImages();

if (count($images) === 0) {
    return;
}

$mainImage = $images->getFirstItem();

foreach ($images as $image) {
    if ($block->isMainImage($image)) {
        $mainImage = $image;
        break;
    }
}

$productId = (int) $block->getProduct()->getId();
?>
<div class="gallery-placeholder _block-content-loading"
     data-gallery-role="gallery-placeholder"
     id="gallery_<?= $productId ?>">
    <div class="product-slider-wrapper col-md-6">
        <div class="main-img-quickview">
            <a href="<?= $block->escapeUrl($mainImage->getData('large_image_url')) ?>"
               class="cloud-zoom"
               rel="transparentImage: 'data:image/gif;base64,R0lGODlhAQABAID/AMDAwAAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==', useWrapper: false, showTitle: false, zoomWidth:'100', adjustY:0, adjustX:0">
                <img src="<?= $block->escapeUrl($mainImage->getData('medium_image_url')) ?>"
                     alt="<?= $block->escapeHtmlAttr($block->getProduct()->getName()) ?>">
            </a>
        </div>
        <div class="quickview-thumbs-shell">
            <button type="button"
                    class="quickview-thumbs-prev awa-carousel__arrow awa-carousel__arrow--prev"
                    aria-label="<?= $block->escapeHtmlAttr(__('Anterior')) ?>">‹</button>
            <div class="quickview-thumbs swiper awa-quickview-thumbs" role="region"
                 aria-roledescription="<?= $block->escapeHtmlAttr(__('carrossel')) ?>"
                 aria-label="<?= $block->escapeHtmlAttr(__('Miniaturas do produto')) ?>">
                <ul class="swiper-wrapper" role="list">
                    <?php foreach ($images as $_image) : ?>
                        <li class="swiper-slide small_image" role="listitem">
                            <img src="<?= $block->escapeUrl($_image->getData('small_image_url')) ?>"
                                 data-href="<?= $block->escapeUrl($_image->getData('large_image_url')) ?>"
                                 data-thumb-image="<?= $block->escapeUrl($_image->getData('medium_image_url')) ?>"
                                 alt=""
                                 loading="lazy">
                        </li>
                    <?php endforeach; ?>
                </ul>
            </div>
            <button type="button"
                    class="quickview-thumbs-next awa-carousel__arrow awa-carousel__arrow--next"
                    aria-label="<?= $block->escapeHtmlAttr(__('Próximo')) ?>">›</button>
        </div>
    </div>
</div>
