<script>
/* Minicart dock: sticky backdrop-filter cria CB curto; altura viewport + bf off. */
(function () {
  function dock() {
    var p = document.querySelector('.minicart-wrapper.is-open .block-minicart, .minicart-wrapper.active .block-minicart, .block-minicart._active, .awa-header-minicart--expanded .block-minicart');
    if (!p || !p.style) return;
    var sticky = document.querySelector('.header-wrapper-sticky');
    if (sticky && sticky.style) {
      sticky.style.setProperty('backdrop-filter', 'none', 'important');
      sticky.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
      sticky.setAttribute('data-awa-mc-bf', 'off');
    }
    var hb = sticky ? sticky.getBoundingClientRect().bottom : 68;
    var h = Math.max(240, Math.round(window.innerHeight - hb));
    p.style.setProperty('top', Math.round(hb) + 'px', 'important');
    p.style.setProperty('bottom', 'auto', 'important');
    p.style.setProperty('height', h + 'px', 'important');
    p.style.setProperty('max-height', h + 'px', 'important');
    p.style.setProperty('min-height', '0', 'important');
  }
  function schedule() { [0, 32, 100, 250, 600].forEach(function (ms) { setTimeout(dock, ms); }); }
  function isMcOpen() {
    return !!document.querySelector('.minicart-wrapper.is-open,.minicart-wrapper.active,.minicart-wrapper.show,.awa-header-minicart--expanded,.block-minicart._active');
  }
  function releaseMc() {
    document.querySelectorAll('.block-minicart').forEach(function (p) {
      if (!p || !p.style) return;
      ['display','visibility','opacity','position','top','right','left','bottom','transform','width','height','max-height','min-height','z-index'].forEach(function (prop) {
        p.style.removeProperty(prop);
      });
      p.classList.remove('_active','active','is-open');
      p.setAttribute('aria-hidden','true');
    });
    document.querySelectorAll('.minicart-wrapper').forEach(function (w) {
      w.classList.remove('active','show','is-open');
    });
    document.querySelectorAll('.awa-header-minicart').forEach(function (s) {
      s.classList.remove('awa-header-minicart--expanded');
    });
  }
  document.addEventListener('click', function (e) {
    var t = e && e.target;
    if (!(t && t.closest)) return;
    if (t.closest('#btn-minicart-close, .block-minicart .action.close, .block-minicart [data-action="close"]')) {
      setTimeout(releaseMc, 0);
      return;
    }
    if (t.closest('.action.showcart, .showcart, [data-awa-minicart-defer="trigger"]')) {
      if (isMcOpen()) {
        e.preventDefault();
        e.stopImmediatePropagation();
        releaseMc();
        return;
      }
      schedule();
    }
  }, true);
  window.addEventListener('resize', function () {
    if (document.querySelector('.minicart-wrapper.is-open, .awa-header-minicart--expanded')) dock();
  }, {passive: true});
})();
</script>
