<?php
/**
 * AWA override — order history empty state + table mobile labels
 *
 * @var \Magento\Sales\Block\Order\History $block
 */
?>
<?php $_orders = $block->getOrders(); ?>
<?php
/** @var \GrupoAwamotos\Theme\ViewModel\OrderHistory|null $orderHistory */
$orderHistory = $block->getData('order_history');
?>
<div class="b2b-page-shell b2b-sales-history">
<?= $block->getChildHtml('info') ?>
<?php if ($_orders && count($_orders)) : ?>
    <div class="table-wrapper orders-history">
        <table class="data table table-order-items history" id="my-orders-table"
               aria-label="<?= $block->escapeHtmlAttr(__('Orders')) ?>">
            <caption class="table-caption sr-only"><?= $block->escapeHtml(__('Orders')) ?></caption>
            <thead>
                <tr>
                    <th scope="col" class="col id"><?= $block->escapeHtml(__('Order #')) ?></th>
                    <th scope="col" class="col date"><?= $block->escapeHtml(__('Date')) ?></th>
                    <?= $block->getChildHtml('extra.column.header') ?>
                    <th scope="col" class="col total"><?= $block->escapeHtml(__('Order Total')) ?></th>
                    <th scope="col" class="col status"><?= $block->escapeHtml(__('Status')) ?></th>
                    <th scope="col" class="col actions"><?= $block->escapeHtml(__('Action')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($_orders as $_order) : ?>
                    <tr>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Order #')) ?>" class="col id"><?= $block->escapeHtml($_order->getRealOrderId()) ?></td>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Date')) ?>" class="col date"><?= /* @noEscape */ $block->formatDate($_order->getCreatedAt()) ?></td>
                        <?php $extra = $block->getChildBlock('extra.container'); ?>
                        <?php if ($extra) : ?>
                            <?php $extra->setOrder($_order); ?>
                            <?= $extra->getChildHtml() ?>
                        <?php endif; ?>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Order Total')) ?>" class="col total"><?= /* @noEscape */ $_order->formatPrice($_order->getGrandTotal()) ?></td>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Status')) ?>" class="col status"><?= $block->escapeHtml($_order->getStatusLabel()) ?></td>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Action')) ?>" class="col actions">
                            <a href="<?= $block->escapeUrl($block->getViewUrl($_order)) ?>"
                               class="action secondary view"
                               aria-label="<?= $block->escapeHtmlAttr(__('View Order')) ?> #<?= $block->escapeHtmlAttr($_order->getRealOrderId()) ?>">
                                <span><?= $block->escapeHtml(__('View Order')) ?></span>
                            </a>
                            <?php
                            $canReorder = $orderHistory instanceof \GrupoAwamotos\Theme\ViewModel\OrderHistory
                                ? $orderHistory->canReorder((int) $_order->getEntityId())
                                : $this->helper(\Magento\Sales\Helper\Reorder::class)->canReorder($_order->getEntityId());
                            ?>
                            <?php if ($canReorder) : ?>
                                <a href="#" data-post='<?= /* @noEscape */
                                $orderHistory instanceof \GrupoAwamotos\Theme\ViewModel\OrderHistory
                                    ? $orderHistory->getReorderPostData($block->getReorderUrl($_order))
                                    : $this->helper(\Magento\Framework\Data\Helper\PostHelper::class)
                                    ->getPostData($block->getReorderUrl($_order))
                                ?>' class="action secondary order"
                                   aria-label="<?= $block->escapeHtmlAttr(__('Reorder')) ?> #<?= $block->escapeHtmlAttr($_order->getRealOrderId()) ?>">
                                    <span><?= $block->escapeHtml(__('Reorder')) ?></span>
                                </a>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
    <?php if ($block->getPagerHtml()) : ?>
        <div class="order-products-toolbar toolbar bottom"><?= $block->getPagerHtml() ?></div>
    <?php endif ?>
<?php else : ?>
    <div class="awa-empty-state" role="status" aria-live="polite">
        <p class="awa-empty-state__title"><?= $block->escapeHtml(__('Nenhum pedido ainda')) ?></p>
        <p class="awa-empty-state__hint"><?= $block->escapeHtml(__('Assim que você concluir uma compra, o histórico completo com status e totais aparecerá aqui.')) ?></p>
        <div class="awa-empty-state__actions">
            <a class="action primary" href="<?= $block->escapeUrl($block->getUrl('')) ?>">
                <?= $block->escapeHtml(__('Ir ao catálogo')) ?>
            </a>
            <a class="action secondary" href="<?= $block->escapeUrl($block->getUrl('b2b/account')) ?>">
                <?= $block->escapeHtml(__('Abrir painel B2B')) ?>
            </a>
        </div>
    </div>
<?php endif ?>
</div>
