<?php
/**
 * AWA Product Shelf Carousel — loader global
 *
 * Emite o par CSS shelf+contract + JS uma única vez por resposta HTML.
 * Guard anti-duplicação: layout/plugin não deve renderizar este bloco duas vezes.
 */
declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
if (!empty($GLOBALS['__awaShelfCarouselLoaderEmitted'])) {
    return;
}
$GLOBALS['__awaShelfCarouselLoaderEmitted'] = true;

$assetVersion = '20260806-carousel-a11y-r1';
$cssUrl = $block->getViewFileUrl('css/awa-shelf-carousel.min.css') . '?v=' . $assetVersion;
$contractCssUrl = $block->getViewFileUrl('css/awa-carousel-contract.min.css') . '?v=' . $assetVersion;
$jsUrl = $block->getViewFileUrl('js/awa-scroll-carousel.min.js') . '?v=' . $assetVersion;
$homeBootstrapUrl = $block->getViewFileUrl('js/awa-home-shelf-bootstrap.min.js') . '?v=' . $assetVersion;
$request = $block->getRequest();
$isHomePage = $request && $request->getFullActionName() === 'cms_index_index';
?>
<?php if ($isHomePage): ?>
<?php /* Home: CSS shelf+contract vão em awa-home-deferred-stack (plugin). Só JS aqui.
 * Config JSON é a fonte canônica da URL do runtime (bootstrap já lê #awa-home-shelf-bootstrap-config). */ ?>
<script type="application/json" id="awa-home-shelf-bootstrap-config"><?= /* @noEscape */ json_encode(
    ['jsSrc' => $jsUrl],
    JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
) ?></script>
<script src="<?= $block->escapeUrl($homeBootstrapUrl) ?>"
        defer
        data-awa-shelf-js="<?= $block->escapeUrl($jsUrl) ?>"
        data-awa-shelf-loader="1"></script>
<?php else: ?>
<?php /* PSI: print→all — geometria pré-init coberta onde há critical inline. */ ?>
<link rel="stylesheet"
      href="<?= $block->escapeUrl($cssUrl) ?>"
      data-awa-shelf-js="<?= $block->escapeHtmlAttr($jsUrl) ?>"
      data-awa-shelf-loader="1"
      media="print"
      onload="this.media='all'"/>
<link rel="stylesheet"
      href="<?= $block->escapeUrl($contractCssUrl) ?>"
      data-awa-carousel-contract="1"
      media="print"
      onload="this.media='all'"/>
<noscript>
    <link rel="stylesheet" href="<?= $block->escapeUrl($cssUrl) ?>"/>
    <link rel="stylesheet" href="<?= $block->escapeUrl($contractCssUrl) ?>"/>
</noscript>
<script src="<?= $block->escapeUrl($jsUrl) ?>" defer></script>
<?php endif; ?>
