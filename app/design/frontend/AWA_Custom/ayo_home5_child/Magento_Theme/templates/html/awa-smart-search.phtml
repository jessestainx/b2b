<script>
(function (w, d) {
    'use strict';
    if (w.__awaSmartSearchInit) return;
    w.__awaSmartSearchInit = true;

    var STORAGE_KEY = 'awa-search-history';
    var MAX_HISTORY = 5;
    var dropdown, searchInput, historyList, clearBtn, sections;

    function init() {
        dropdown = d.querySelector('[data-awa-smart-search]');
        searchInput = d.getElementById('search');
        if (!dropdown || !searchInput) return;

        historyList = dropdown.querySelector('[data-awa-history-list]');
        clearBtn = dropdown.querySelector('[data-awa-clear-history]');
        sections = {
            history: dropdown.querySelector('[data-awa-section="history"]'),
            popular: dropdown.querySelector('[data-awa-section="popular"]'),
            categories: dropdown.querySelector('[data-awa-section="categories"]')
        };

        renderHistory();
        bindEvents();
    }

    function getHistory() {
        try {
            return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch (e) { return []; }
    }

    function saveHistory(terms) {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(terms)); } catch (e) {}
    }

    function addToHistory(term) {
        if (!term || term.length < 2) return;
        var history = getHistory();
        history = history.filter(function (t) { return t !== term; });
        history.unshift(term);
        if (history.length > MAX_HISTORY) history = history.slice(0, MAX_HISTORY);
        saveHistory(history);
    }

    function renderHistory() {
        var history = getHistory();
        if (history.length === 0) {
            sections.history.hidden = true;
            return;
        }
        sections.history.hidden = false;
        historyList.innerHTML = history.map(function (term, i) {
            return '<li role="option" tabindex="-1" data-awa-history-item data-term="' + escapeHtml(term) + '">' +
                '<a href="/catalogsearch/result/?q=' + encodeURIComponent(term) + '">' +
                    '<span class="awa-smart-search__term">' + escapeHtml(term) + '</span>' +
                    '<button type="button" class="awa-smart-search__remove" data-awa-remove-history="' + i + '" aria-label="' + escapeHtml(window.AWA_JS_I18N.remove) + ' ' + escapeHtml(term) + '">' +
                        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
                    '</button>' +
                '</a></li>';
        }).join('');
    }

    function bindEvents() {
        var debounceTimer;
        searchInput.addEventListener('focus', showDropdown);
        searchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(handleInput, 200);
        });
        // Submit - save to history
        var form = searchInput.closest('form');
        if (form) {
            form.addEventListener('submit', function () {
                addToHistory(searchInput.value.trim());
            });
        }
        // Clear history
        if (clearBtn) {
            clearBtn.addEventListener('click', function () {
                saveHistory([]);
                renderHistory();
                if (w.AWA && w.AWA.toast) {
                    w.AWA.toast.info('Historico de buscas limpo');
                }
            });
        }
        // Remove item
        if (historyList) {
            historyList.addEventListener('click', function (e) {
                var rm = e.target.closest('[data-awa-remove-history]');
                if (rm) {
                    e.preventDefault();
                    var history = getHistory();
                    history.splice(parseInt(rm.getAttribute('data-awa-remove-history'), 10), 1);
                    saveHistory(history);
                    renderHistory();
                }
            });
        }
        // Click fora
        d.addEventListener('click', function (e) {
            if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                hideDropdown();
            }
        });
        // Escape
        d.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') hideDropdown();
        });
    }

    function handleInput() {
        var q = searchInput.value.trim();
        if (q.length < 2) {
            // Mostrar history
            sections.popular.hidden = false;
            sections.categories.hidden = false;
            renderHistory();
            showDropdown();
            return;
        }
        // Esconder popular/categories quando ha query
        sections.popular.hidden = true;
        sections.categories.hidden = true;
        showDropdown();
        // (Aqui poderia chamar endpoint AJAX para sugestoes)
    }

    function showDropdown() {
        if (dropdown) dropdown.hidden = false;
    }

    function hideDropdown() {
        if (dropdown) dropdown.hidden = true;
    }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    // Public API
    w.AWA = w.AWA || {};
    w.AWA.search = {
        addHistory: addToHistory,
        clearHistory: function () { saveHistory([]); renderHistory(); },
        getHistory: getHistory
    };

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
        init();
    }
})(window, document);
</script>

