<script id="awa-home-scale-layout-probe">
(function (window, document) {
    'use strict';

    var sent = 0;
    var lastSignature = '';

    function box(selector) {
        var element = document.querySelector(selector);
        var rect;
        var style;

        if (!element) {
            return null;
        }

        rect = element.getBoundingClientRect();
        style = window.getComputedStyle(element);

        return {
            selector: selector,
            rect: [
                Math.round(rect.x),
                Math.round(rect.y),
                Math.round(rect.width),
                Math.round(rect.height)
            ],
            maxWidth: style.maxWidth,
            margin: style.margin,
            padding: style.padding,
            transform: style.transform,
            fontSize: style.fontSize,
            lineHeight: style.lineHeight
        };
    }

    function sections() {
        var nodes = Array.prototype.slice.call(document.querySelectorAll(
            '.awa-home-section,.awa-carousel-section,.rokan-newproduct,.rokan-bestseller,'
            + '.rokan-mostviewed,.awa-home-pricing-notice,.awa-hero-b2b-cta'
        )).filter(function (element, index, all) {
            var rect = element.getBoundingClientRect();
            return rect.width > 0 && rect.height > 0 && all.indexOf(element) === index;
        }).sort(function (left, right) {
            return left.getBoundingClientRect().top - right.getBoundingClientRect().top;
        }).slice(0, 12);
        var previousBottom = null;

        return nodes.map(function (element) {
            var rect = element.getBoundingClientRect();
            var item = {
                name: String(element.className || element.id || element.tagName).slice(0, 90),
                y: Math.round(rect.y + window.scrollY),
                width: Math.round(rect.width),
                height: Math.round(rect.height),
                gap: previousBottom === null
                    ? null
                    : Math.round(rect.top + window.scrollY - previousBottom)
            };

            previousBottom = rect.bottom + window.scrollY;
            return item;
        });
    }

    function capture(stage) {
        var viewport = window.visualViewport;
        var data;
        var signature;

        if (!document.body || sent >= 4) {
            return;
        }

        data = {
            stage: stage,
            viewport: {
                inner: [window.innerWidth, window.innerHeight],
                client: [document.documentElement.clientWidth, document.documentElement.clientHeight],
                visual: viewport
                    ? [Math.round(viewport.width), Math.round(viewport.height), viewport.scale]
                    : null,
                screen: [window.screen.width, window.screen.height],
                dpr: window.devicePixelRatio
            },
            root: box('html'),
            header: box('.awa-main-header .header-main > .container'),
            headerInner: box('.awa-main-header__inner.wp-header'),
            search: box('#search'),
            nav: box('.awa-nav-bar__inner'),
            hero: box('.top-home-content--above-fold'),
            pageMain: box('.page-main'),
            firstShelf: box('.content-top-home .awa-shelf--carousel'),
            footer: box('.page-footer .footer-container, .page_footer .footer-container'),
            sectionTitle: box('.content-top-home h2'),
            productTitle: box('.content-top-home .product-item-link'),
            sections: sections()
        };
        signature = JSON.stringify(data);

        if (signature === lastSignature) {
            return;
        }

        sent += 1;
        lastSignature = signature;


    }

    capture('inline');
    window.requestAnimationFrame(function () {
        capture('first-frame');
    });
    window.addEventListener('load', function () {
        window.requestAnimationFrame(function () {
            capture('window-load');
        });
    }, { once: true });

    if ('ResizeObserver' in window && document.querySelector('.page-main')) {
        (new ResizeObserver(function () {
            capture('page-main-resize');
        })).observe(document.querySelector('.page-main'));
    }
}(window, document));
</script>

