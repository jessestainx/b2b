<script id="awa-promo-runtime-probe">
(function (window, document) {
    'use strict';

    var sent = 0;
    var lastSignature = '';

    function metric(element) {
        var rect;
        var style;

        if (!element) {
            return null;
        }

        rect = element.getBoundingClientRect();
        style = window.getComputedStyle(element);

        return {
            rect: [
                Math.round(rect.x),
                Math.round(rect.y),
                Math.round(rect.width),
                Math.round(rect.height)
            ],
            client: [element.clientWidth, element.clientHeight],
            scroll: [element.scrollWidth, element.scrollHeight],
            height: style.height,
            lineHeight: style.lineHeight,
            overflow: style.overflow,
            color: style.color,
            background: style.backgroundColor
        };
    }

    function capture(stage) {
        var bar = document.getElementById('awa-b2b-promo-bar');
        var text = document.querySelector('.awa-b2b-promo-bar__text');
        var data;
        var signature;

        if (!bar || !text || sent >= 4) {
            return;
        }

        data = {
            stage: stage,
            readyState: document.readyState,
            viewport: [window.innerWidth, window.innerHeight],
            devicePixelRatio: window.devicePixelRatio,
            serviceWorkerControlled: Boolean(
                window.navigator.serviceWorker && window.navigator.serviceWorker.controller
            ),
            bar: metric(bar),
            text: metric(text),
            cta: metric(document.querySelector('.awa-b2b-promo-bar__cta')),
            close: metric(document.getElementById('awa-b2b-promo-close')),
            css: Array.prototype.map.call(document.styleSheets, function (sheet) {
                return sheet.href ? sheet.href.split('/').pop().slice(0, 160) : 'inline';
            }).filter(function (href) {
                return href.indexOf('awa-') !== -1 || href.indexOf('themes') !== -1;
            }).slice(-12)
        };
        signature = JSON.stringify(data);

        if (signature === lastSignature) {
            return;
        }

        sent += 1;
        lastSignature = signature;


    }

    capture('inline');
    window.requestAnimationFrame(function () {
        capture('first-frame');
    });
    window.addEventListener('load', function () {
        window.requestAnimationFrame(function () {
            capture('window-load');
        });
    }, { once: true });

    if ('ResizeObserver' in window) {
        (new ResizeObserver(function () {
            capture('resize-observer');
        })).observe(document.getElementById('awa-b2b-promo-bar'));
    }
}(window, document));
</script>

