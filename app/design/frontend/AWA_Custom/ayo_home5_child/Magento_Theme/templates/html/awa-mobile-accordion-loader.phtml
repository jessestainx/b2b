<?php
declare(strict_types=1);
/**
 * M09+M10: Mobile accordion JS loader
 * Carrega apenas em viewports mobile, adiado até o footer entrar no viewport.
 */
?>
<script>
(function (w, d) {
    'use strict';

    var loaded = false;
    var src = <?= /* @noEscape */ json_encode(
        $block->getViewFileUrl('js/awa-mobile-accordion.min.js') . '?v=20260528-footer-loader',
        JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
    ) ?>;

    function isMobile() {
        return !!(w.matchMedia && w.matchMedia('(max-width:767px)').matches);
    }

    function appendScript() {
        if (loaded || !isMobile() || d.querySelector('script[data-awa-mobile-accordion-loader="1"]')) {
            return;
        }

        loaded = true;
        var script = d.createElement('script');
        script.src = src;
        script.defer = true;
        script.setAttribute('data-awa-mobile-accordion-loader', '1');
        (d.body || d.documentElement).appendChild(script);
    }

    function scheduleLoad() {
        if (!isMobile()) {
            return;
        }

        var footer = d.querySelector('.page_footer, .page-footer, .footer.content');
        if (footer && 'IntersectionObserver' in w) {
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) {
                        return;
                    }
                    observer.disconnect();
                    appendScript();
                });
            }, { rootMargin: '240px 0px 0px 0px' });
            observer.observe(footer);
            return;
        }

        /* safe4 home: sem idle — só IO no footer ou interação */
        var isHome = d.body && d.body.classList.contains('cms-index-index');
        if (!isHome) {
            if ('requestIdleCallback' in w) {
                w.requestIdleCallback(appendScript, { timeout: 6000 });
            } else {
                w.addEventListener('load', function () {
                    w.setTimeout(appendScript, 3500);
                }, { once: true });
            }
        }
    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', scheduleLoad, { once: true });
    } else {
        scheduleLoad();
    }

    w.addEventListener('resize', function () {
        if (isMobile()) {
            scheduleLoad();
        }
    }, { passive: true });
}(window, document));
</script>
