<?php declare(strict_types=1);
/**
 * LCP Hero Image Preload — apenas <link rel="preload"> (descoberta imediata).
 *
 * Deve renderizar no início de head.additional, antes de CSS inline (~110KB),
 * para eliminar load delay no LCP (PSI/Lighthouse).
 *
 * @var \GrupoAwamotos\Theme\Block\Html\HeroPreload $block
 */
$heroPreloadUrl = $block->getHeroImageUrl();
if ($heroPreloadUrl === '') {
    return;
}
$heroMobileUrl = $block->getHeroImageMobileUrl() ?: $heroPreloadUrl;
$heroSrcset = $block->getHeroImageSrcset();
$heroMobileSrcset = $block->getHeroImageMobileSrcset() ?: $heroSrcset;
$heroSizes = $block->getHeroImageSizes();
$heroMobileSizes = $block->getHeroImageMobileSizes();
?>
<?php
/**
 * Magento / web.dev LCP: rel=preload + fetchpriority=high com media query
 * (prefetch/low atrasava descoberta do hero — regressão PSI).
 * r44: imagesrcset/imagesizes alinham preload ao candidato 1200w tipico.
 */
?>
<link rel="preload"
      href="<?= $block->escapeUrl($heroMobileUrl) ?>"
      as="image"
      type="image/webp"
      media="(max-width: 767px)"
      <?php if ($heroMobileSrcset !== ''): ?>imagesrcset="<?= $block->escapeHtmlAttr($heroMobileSrcset) ?>"
      imagesizes="<?= $block->escapeHtmlAttr($heroMobileSizes) ?>"
      <?php endif; ?>fetchpriority="high"/>
<link rel="preload"
      href="<?= $block->escapeUrl($heroPreloadUrl) ?>"
      as="image"
      type="image/webp"
      media="(min-width: 768px)"
      <?php if ($heroSrcset !== ''): ?>imagesrcset="<?= $block->escapeHtmlAttr($heroSrcset) ?>"
      imagesizes="<?= $block->escapeHtmlAttr($heroSizes) ?>"
      <?php endif; ?>fetchpriority="high"/>