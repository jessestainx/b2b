    border: 1px solid #d1d5db;
}
.awa-push-prompt__decline:hover { background: #f3f4f6; }
@media (max-width: 480px) {
    .awa-push-prompt {
        left: 12px;
        right: 12px;
        bottom: 12px;
        max-width: none;
    }
}
@media (prefers-reduced-motion: reduce) {
    .awa-push-prompt { animation: none; }
}
</style>
