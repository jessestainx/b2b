declare(strict_types=1);

/**
 * AWA B2B — Back to Top Button.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
?>
<button type="button"
        class="awa-back-to-top"
        id="awa-back-to-top"
        data-awa-back-to-top="true"
        data-mage-init='{"js/awa-back-to-top": {"threshold": 600}}'
<?php /* A11Y-001: sem aria-hidden aqui — o atributo nativo "hidden" ja remove
