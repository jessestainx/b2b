<?php
/**
 * AWA Motos - A/B Testing Foundation (2026-06-28)
 *
 * Sistema de experimentacao simples com:
 * - Atribuicao consistente via hash do user ID
 * - Suporte a variantes (control, variant_a, variant_b)
 * - Expor variantes via CSS class no <body>
 * - Tracking via dataLayer
 * - Persistencia em cookie (30 dias)
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
?>
<script>
(function (w, d) {
    'use strict';
    if (w.__awaABTestingInit) return;
    w.__awaABTestingInit = true;

    /**
     * Definicao dos experimentos ativos
     * Formato: { experiment_id: { control: 50, variant_a: 50 } }
     */
    var EXPERIMENTS = {
        'hero_cta_color': { control: 50, variant_a: 50 },
        'product_card_layout': { control: 33, variant_a: 33, variant_b: 34 },
        'free_shipping_threshold': { control: 50, variant_a: 50 },
        'checkout_button_text': { control: 50, variant_a: 50 }
    };

    var COOKIE_NAME = 'awa-experiments';
    var COOKIE_DAYS = 30;
    var STORAGE_KEY = 'awa_experiment_variants';

    function setCookie(name, value, days) {
        var d = new Date();
        d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
        d.cookie = name + '=' + value + ';expires=' + d.toUTCString() + ';path=/';
    }

    function getCookie(name) {
        var nameEQ = name + '=';
        var ca = d.cookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i].trim();
            if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length);
        }
        return null;
    }

    function hashCode(str) {
        var hash = 0;
        for (var i = 0; i < str.length; i++) {
            var chr = str.charCodeAt(i);
            hash = ((hash << 5) - hash) + chr;
            hash |= 0;
        }
        return Math.abs(hash);
    }

    function getUserId() {
        var id = getCookie('awa-uid');
        if (!id) {
            id = 'awa-' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
            setCookie('awa-uid', id, 365);
        }
        return id;
    }

    function assignVariants(experiments) {
        var userId = getUserId();
        var hash = hashCode(userId);
        var result = {};
        var i = 0;
        for (var expId in experiments) {
            if (experiments.hasOwnProperty(expId)) {
                var weights = experiments[expId];
                var variants = Object.keys(weights);
                var totalWeight = 0;
                for (var v = 0; v < variants.length; v++) {
                    totalWeight += weights[variants[v]];
                }
                var userHash = (hash + i) % totalWeight;
                var cumulative = 0;
                var assigned = variants[0];
                for (var j = 0; j < variants.length; j++) {
                    cumulative += weights[variants[j]];
                    if (userHash < cumulative) {
                        assigned = variants[j];
                        break;
                    }
                }
                result[expId] = assigned;
                i++;
            }
        }
        return result;
    }

    function applyVariants(variants) {
        var body = d.body;
        // Limpar variantes anteriores
        var classes = body.className.split(' ');
        for (var i = classes.length - 1; i >= 0; i--) {
            if (classes[i].indexOf('awa-exp-') === 0) {
                body.classList.remove(classes[i]);
            }
        }
        // Aplicar novas
        for (var exp in variants) {
            if (variants.hasOwnProperty(exp)) {
                body.classList.add('awa-exp-' + exp + '--' + variants[exp]);
            }
        }
    }

    function trackExposure(variants) {
        if (typeof w.dataLayer === 'undefined') {
            w.dataLayer = w.dataLayer || [];
        }
        w.dataLayer.push({
            event: 'experiment_exposure',
            experiments: variants,
            user_id: getUserId(),
            timestamp: Date.now()
        });
    }

    function init() {
        try {
            // Verificar se ja tem variantes salvas
            var stored = localStorage.getItem(STORAGE_KEY);
            var variants;
            if (stored) {
                variants = JSON.parse(stored);
            } else {
                variants = assignVariants(EXPERIMENTS);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(variants));
            }
            applyVariants(variants);
            trackExposure(variants);
            // Expor globalmente para outros scripts
            w.awaExperiments = variants;
        } catch (e) {
            console.warn('[AWA] AB Testing init failed', e);
        }
    }

    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
        init();
    }
})(window, document);
</script>
