<?php
/**
 * AWA Motos - Review form override
 *
 * Sprint a11y (2026-06-28): corrigido bug onde escapeHtmlAttr estava convertendo
 * IDs com caracteres acentuados em HTML entities, quebrando o aria-labelledby.
 *
 * @var \Magento\Review\Block\Form $block
 */
?>
<?php if ($block->getAllowWriteReviewFlag()): ?>
<form action="<?= $block->escapeUrl($block->getAction()) ?>" method="post" id="review-form" class="review-form" data-role="product-review-form" data-bind="scope: 'review-form'">
    <?= $block->getBlockHtml('formkey') ?>
    <?= $block->getChildHtml('form_additional_before') ?>
    <fieldset class="review-fieldset" data-hasrequired="<?= $block->escapeHtmlAttr(__('* Required Fields')) ?>">
        <legend class="review-legend"><span><?= $block->escapeHtml(__("You're reviewing:")) ?></span><strong><?= $block->escapeHtml($block->getProductInfo()->getName()) ?></strong></legend>
        <br />
        <?php if ($block->getRatings() && $block->getRatings()->getSize()): ?>
        <fieldset class="review-field-ratings">
            <legend class="review-legend"><?= $block->escapeHtml(__('Your Rating')) ?>:</legend>
            <?php foreach ($block->getRatings() as $_rating): ?>
                <?php
                // AWA: gerar ID ASCII-safe para o label (remove acentos)
                $ratingCode = $_rating->getRatingCode();
                $ratingCodeAscii = preg_replace('/[^a-zA-Z0-9_]/', '_', $ratingCode);
                $ratingId = $ratingCodeAscii . '_rating_label';
                ?>
                <div class="field review-field-rating">
                    <label class="label" id="<?= $block->escapeHtmlAttr($ratingId) ?>"><span><?= $block->escapeHtml($ratingCode) ?></span></label>
                    <div class="control review-control-vote">
                    <?php $options = $_rating->getOptions();?>
                    <?php $iterator = 1; foreach ($options as $_option): ?>
                        <?php
                        $optionId = $ratingCodeAscii . '_' . $block->escapeHtmlAttr($_option->getValue());
                        $optionLabelId = $optionId . '_label';
                        ?>
                        <input
                            type="radio"
                            name="ratings[<?= $block->escapeHtmlAttr($_rating->getId()) ?>]"
                            id="<?= $optionId ?>"
                            value="<?= $block->escapeHtmlAttr($_option->getId()) ?>"
                            class="radio"
                            data-validate="{'rating-required':true}"
                            aria-labelledby="<?= $block->escapeHtmlAttr($ratingId) ?> <?= $block->escapeHtmlAttr($optionLabelId) ?>" />
                        <label
                            class="rating-<?= $block->escapeHtmlAttr($iterator) ?>"
                            for="<?= $optionId ?>"
                            title="<?= $block->escapeHtmlAttr(__('%1 %2', $iterator, $iterator == 1 ? 'star' : 'stars')) ?>"
                            id="<?= $block->escapeHtmlAttr($optionLabelId) ?>">
                            <span><?= $block->escapeHtml(__('%1 %2', $iterator, $iterator == 1 ? 'star' : 'stars')) ?></span>
                        </label>
                    <?php $iterator++; endforeach; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </fieldset>
        <?php endif; ?>
        <div class="field review-field-nickname required">
            <label for="nickname_field" class="label"><span><?= $block->escapeHtml(__('Nickname')) ?></span></label>
            <div class="control">
                <input type="text" name="nickname" id="nickname_field" class="input-text" data-validate="{required:true}" placeholder="<?= $block->escapeHtmlAttr(__('Seu nome ou apelido')) ?>" data-bind="value: nickname()" />
            </div>
        </div>
        <div class="field review-field-summary required">
            <label for="summary_field" class="label"><span><?= $block->escapeHtml(__('Summary')) ?></span></label>
            <div class="control">
                <input type="text" name="title" id="summary_field" class="input-text" data-validate="{required:true}" placeholder="<?= $block->escapeHtmlAttr(__('Resumo da sua avaliacao')) ?>" data-bind="value: review().title" />
            </div>
        </div>
        <div class="field review-field-text required">
            <label for="review_field" class="label"><span><?= $block->escapeHtml(__('Review')) ?></span></label>
            <div class="control">
                <textarea name="detail" id="review_field" cols="5" rows="3" data-validate="{required:true}" placeholder="<?= $block->escapeHtmlAttr(__('Conte sua experiencia com o produto')) ?>" data-bind="value: review().detail"></textarea>
            </div>
        </div>
    </fieldset>
    <div class="review-form-actions">
        <div class="primary actions-primary">
            <button type="submit" class="action submit primary"
                    aria-label="<?= $block->escapeHtmlAttr(__('Enviar avaliacao do produto')) ?>">
                <span><?= $block->escapeHtml(__('Submit Review')) ?></span>
            </button>
        </div>
    </div>
</form>
<script type="text/x-magento-init">
{
    "*": {
        "Magento_Review/js/review": {
            "productReviewUrl": "<?= $block->escapeJs($block->getProductReviewUrl()) ?>",
            "reviewsTabUrl": "<?= $block->escapeJs($block->getProductReviewsUrl()) ?>"
        }
    }
}
</script>
<?php else: ?>
<div class="message info notlogged" id="review-form">
    <div>
        <?= $block->escapeHtml(__('Only registered users can write reviews. Please <a href="%1">Sign in</a> or <a href="%2">create an account</a>', $block->getLoginLink(), $block->getRegisterUrl())) ?>
    </div>
</div>
<?php endif; ?>
