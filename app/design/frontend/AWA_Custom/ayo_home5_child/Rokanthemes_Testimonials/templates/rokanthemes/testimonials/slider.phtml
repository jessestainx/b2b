			"itemsMobile": [480, 1],
			"navigation": false,
			"pagination": true,
			"label": "<?php echo $block->escapeJs(__('Depoimentos')); ?>"
		}
	}
}
</script>
<?php else :?>
<div class="box-bottom-home2 box-testimo">
  <span><?php echo __('Testimonial records not available.'); ?></span>
</div>
