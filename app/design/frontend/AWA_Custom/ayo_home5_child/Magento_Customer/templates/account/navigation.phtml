<?php

declare(strict_types=1);

/**
 * AWA account sidebar — grouped navigation with AWA class contract.
 *
 * @var \Magento\Customer\Block\Account\Navigation $block
 */

use GrupoAwamotos\B2B\Block\Account\NavSection;
use Magento\Customer\Block\Account\Delimiter;
use Magento\Framework\View\Element\Html\Link\Current;

$childBlocks = $block->getLinks();
if ($childBlocks === []) {
    return;
}
?>
<div class="account-nav-wrapper" role="navigation" aria-label="<?= $block->escapeHtmlAttr(__('Navegação da conta')) ?>">
    <div class="account-nav-title">
        <strong><?= $block->escapeHtml(__('Portal B2B')) ?></strong>
    </div>
    <ul class="account-nav-items">
        <?php foreach ($childBlocks as $child): ?>
            <?php if ($child instanceof NavSection): ?>
                <?= /* @noEscape */ $block->getLayout()->renderElement($child->getNameInLayout()) ?>
                <?php continue; ?>
            <?php endif; ?>

            <?php if ($child instanceof Delimiter): ?>
                <?php continue; ?>
            <?php endif; ?>

            <?php if ($child instanceof Current): ?>
                <?php
                $isCurrent = $child->isCurrent();
                $itemClass = 'account-nav-item' . ($isCurrent ? ' current' : '');
                ?>
                <li class="<?= $block->escapeHtmlAttr($itemClass) ?>">
                    <?php if ($isCurrent): ?>
                        <strong class="account-nav-text" aria-current="page">
                            <?= $block->escapeHtml($child->getLabel()) ?>
                        </strong>
                    <?php else: ?>
                        <a href="<?= $block->escapeUrl($child->getHref()) ?>"
                           class="account-nav-link">
                            <?= $block->escapeHtml($child->getLabel()) ?>
                        </a>
                    <?php endif; ?>
                </li>
                <?php continue; ?>
            <?php endif; ?>

            <li class="account-nav-item account-nav-item--legacy">
                <?= /* @noEscape */ $block->renderLink($child) ?>
            </li>
        <?php endforeach; ?>
    </ul>
</div>
