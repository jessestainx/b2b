<?php
/**
 * AWA Motos - SEO <head> extras for the homepage.
 * Child theme override: removes fetchpriority="high" from logo preload.
 * On the homepage, the LCP is the hero slider (preloaded in awa-hero-preload.phtml),
 * not the logo. Competing fetchpriority="high" resources delay the actual LCP image.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
$baseUrl = rtrim($block->getBaseUrl(), '/');
?>
<link rel="canonical" href="<?= /* @noEscape */ $baseUrl . '/' ?>" />
<!-- JSON-LD da home é emitido em Magento_Cms::awa-seo-jsonld.phtml (before.body.end).
     Evita duplicidade de schema no HTML e reduz payload crítico do <head>. -->

<?php /* Logo preload omitido na home — LCP é o hero; preload do logo gerava warning sem ganho no 1º paint. */ ?>
