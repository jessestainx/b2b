<?php
/**
 * AWA Motos - Cart Progress Indicator + Continue Shopping
 *
 * Sprint 3 (UX): indica progresso para frete gratis e link continuar comprando.
 */
declare(strict_types=1);

$_subtotal = (float) $block->getLayout()->getBlock('checkout.cart')->getQuote()->getSubtotal();
$_freeShippingThreshold = 199.0; // >= R$ 199 = frete gratis
$_remaining = max(0, $_freeShippingThreshold - $_subtotal);
$_progress = $_freeShippingThreshold > 0 ? min(100, ($_subtotal / $_freeShippingThreshold) * 100) : 100;
$_percentComplete = (int) $_progress;
$_isFreeShipping = $_subtotal >= $_freeShippingThreshold;
$_currency = 'BRL';
$_symbol = 'R$';
$_storeUrl = $block->getBaseUrl();
?>
<div class="awa-cart-progress" data-awa-cart-progress aria-label="<?= $block->escapeHtmlAttr(__('Progresso para frete gratis')) ?>">

    <?php if ($_isFreeShipping): ?>
    <p class="awa-cart-progress__success" role="status">
        <span aria-hidden="true">✓</span>
        <?= $block->escapeHtml(__('Voce ganhou frete gratis!')) ?>
    </p>
    <?php else: ?>
    <p class="awa-cart-progress__hint" role="status">
        <?= $block->escapeHtml(__('Faltam ' . $_symbol . ' ' . number_format($_remaining, 2, ',', '.') . ' para voce ganhar frete gratis')) ?>
    </p>
    <?php endif; ?>

    <div class="awa-cart-progress__bar"
         role="progressbar"
         aria-valuenow="<?= $block->escapeHtmlAttr($_percentComplete) ?>"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-label="<?= $block->escapeHtmlAttr(__('Progresso para frete gratis')) ?>">
        <div class="awa-cart-progress__fill" style="width: <?= $block->escapeHtmlAttr($_percentComplete) ?>%"></div>
        <span class="awa-cart-progress__milestone awa-cart-progress__milestone--start" aria-hidden="true"></span>
        <span class="awa-cart-progress__milestone awa-cart-progress__milestone--end" aria-hidden="true"></span>
    </div>

    <div class="awa-cart-progress__actions">
        <a href="<?= $block->escapeUrl($_storeUrl) ?>"
           class="awa-cart-progress__continue action secondary"
           aria-label="<?= $block->escapeHtmlAttr(__('Continuar comprando mais produtos')) ?>">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            <?= $block->escapeHtml(__('Continuar comprando')) ?>
        </a>

        <button type="button"
                class="awa-cart-progress__save-for-later"
                data-awa-save-for-later
                aria-label="<?= $block->escapeHtmlAttr(__('Salvar carrinho para depois')) ?>">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
            <?= $block->escapeHtml(__('Salvar para depois')) ?>
        </button>
    </div>
</div>

