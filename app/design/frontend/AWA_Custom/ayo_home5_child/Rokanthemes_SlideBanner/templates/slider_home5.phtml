// @codingStandardsIgnoreFile
if ($banners = $block->getBannerCollection()):
    /** @var \GrupoAwamotos\Theme\ViewModel\HeroResponsiveImage|null $heroResponsive */
    $heroResponsive = $block->getData('hero_responsive_view_model');
    $slider = $block->getSlider();
    $sliderId = (int) $slider->getId();
    $settings = $slider->getSliderSetting();
    $swiperConfig = [
        'slidesPerView' => 1,
        'autoHeight' => false,
        'effect' => 'fade',
        'loop' => true,
        'speed' => 500,
        'navigation' => true,
        'pagination' => true,
        'autoplay' => 12000,
    ];
    $booleanKeys = ['navigation', 'stopOnHover', 'pagination'];

    $legacyHosts = ['srv1113343.hstgr.cloud', 'www.srv1113343.hstgr.cloud'];
    $baseUrl = rtrim((string) $block->getBaseUrl(), '/');
    $baseHost = (string) parse_url($baseUrl, PHP_URL_HOST);
    $baseScheme = (string) parse_url($baseUrl, PHP_URL_SCHEME);
    $resolveSlideLink = static function (?string $link) use ($legacyHosts, $baseHost, $baseScheme): string {
        if (!is_string($link)) {
            return '';
        }

        $link = trim($link);
        if ($link === '') {
            return '';
        }

        $parts = parse_url($link);
        if (!is_array($parts)) {
            return $link;
        }

        $linkHost = isset($parts['host']) ? strtolower((string) $parts['host']) : '';
        if ($linkHost === '' || !in_array($linkHost, $legacyHosts, true) || $baseHost === '' || $baseScheme === '') {
            return $link;
        }

        $path = isset($parts['path']) ? (string) $parts['path'] : '/';
        $path = $path !== '' ? $path : '/';
        $query = isset($parts['query']) ? ('?' . $parts['query']) : '';
        $fragment = isset($parts['fragment']) ? ('#' . $parts['fragment']) : '';

        return $baseScheme . '://' . $baseHost . $path . $query . $fragment;
    };

    foreach ($settings as $key => $value) {
        if ($key === 'autoPlay') {
            // AWA 2026-06-17 (impeccable go): autoplay mais lento — balcão > promo rotativa.
            $delay = is_numeric($value) ? (int) $value : 12000;
            $swiperConfig['autoplay'] = max(10000, $delay);
            continue;
        }

        if (in_array($key, $booleanKeys, true)) {
            $swiperConfig[$key] = ((int) $value) === 1;
            continue;
        }

        if (is_string($value)) {
            $trimmed = trim($value);

            if (is_numeric($trimmed)) {
                if ($key === 'slideSpeed') {
                    $swiperConfig['speed'] = max(0, (int) $trimmed);
                } else {
                    $swiperConfig[$key] = (strpos($trimmed, '.') !== false) ? (float) $trimmed : (int) $trimmed;
                }
                continue;
            }
        }

        $swiperConfig[$key] = $value;
    }
    // AWA 2026-06-17: autoplay 12s por padrão (reduce-promo); admin pode override.
    if (!isset($swiperConfig['autoplay']) || $swiperConfig['autoplay'] === false) {
        $swiperConfig['autoplay'] = 12000;
    }
    // AWA hardening (2026-06-03): blinda slide_text malformado/truncado contra quebra de DOM
    $renderSafeSlideText = static function ($rawText) use ($block): string {
        $rendered = (string) $block->getContentText($rawText);
        $lower = strtolower($rendered);
        $openA = substr_count($lower, '<a ') + substr_count($lower, '<a>');
        $closeA = substr_count($lower, '</a>');
        $ltCount = substr_count($rendered, '<');
        $gtCount = substr_count($rendered, '>');
        if ($openA !== $closeA || $ltCount !== $gtCount) {
            return $block->escapeHtml(trim(strip_tags($rendered)));
        }
        return $rendered;
    };
    $renderB2bCta = static function (string $link, $rawText) use ($block): string {
        $path = (string) parse_url($link, PHP_URL_PATH);
        if (rtrim($path, '/') !== '/b2b/register' || stripos((string) $rawText, 'slide-btn') !== false) {
            return '';
        }

        return '<a href="' . $block->escapeUrl($link)
            . '" class="action primary awa-hero-slide__cta">'
            . $block->escapeHtml(__('Cadastrar no B2B'))
            . '</a>';
    };
?>
