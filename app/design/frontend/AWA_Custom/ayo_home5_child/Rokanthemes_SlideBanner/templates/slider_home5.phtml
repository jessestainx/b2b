        // #region agent log
        fetch('http://localhost:7480/ingest/9a5bd517-cd53-4948-bac5-5aea194478a3',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'ca59a1'},body:JSON.stringify({sessionId:'ca59a1',runId:'post-fix',hypothesisId:'H116-H118',location:'slider_home5.phtml:hero-cta-probe',message:'Active B2B hero CTA runtime state',data:{viewportWidth:w.innerWidth,text:(activeCta.textContent||'').trim(),hrefPath:activeCta.pathname,width:Math.round(rect.width),height:Math.round(rect.height),display:style.display,visibility:style.visibility,opacity:style.opacity,slideOpacity:w.getComputedStyle(activeCta.closest('.swiper-slide')).opacity},timestamp:Date.now()})}).catch(function () {});
