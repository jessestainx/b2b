        (new Image()).src = '/b2b/account/login/?awa_dbg=1'
            + '&sid=ca59a1&run=post-fix&hyp=H119'
            + '&loc=' + encodeURIComponent('slider_home5.phtml:hero-cta-same-origin')
            + '&msg=' + encodeURIComponent('Active B2B CTA same-origin fallback')
            + '&ts=' + Date.now()
            + '&transport=hero-cta-image'
            + '&data=' + encodeURIComponent(JSON.stringify({
                viewportWidth: w.innerWidth,
                text: (activeCta.textContent || '').trim(),
                hrefPath: activeCta.pathname,
                width: Math.round(rect.width),
                height: Math.round(rect.height),
                display: style.display,
                visibility: style.visibility,
                opacity: style.opacity,
                slideOpacity: w.getComputedStyle(activeCta.closest('.swiper-slide')).opacity
            }).slice(0, 420));
        // #endregion
    }

    observer = new MutationObserver(probeActiveCta);
    observer.observe(d.documentElement, {
        attributes: true,
        subtree: true,
