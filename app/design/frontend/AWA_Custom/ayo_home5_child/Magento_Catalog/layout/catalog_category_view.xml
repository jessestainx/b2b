<?xml version="1.0"?>
<!--
  AWA Motos — Category Page Layout Overrides
  - Remove duplicate H1 (page.main.title) since category hero already has H1
  - PLP-P0-005/006 (docs/visual-qa/VISUAL_FIX_PLAN.md): remove sale.reorder.sidebar —
    mesmo padrao ja aplicado na Home (Magento_Cms/layout/cms_index_index.xml). O widget
    nativo "Pedidos feitos recentemente" nao pertence a PLP: aparecia vazio para guest e,
    para cliente logado com pedidos, exibia CTAs "Adicionar ao carrinho" duplicados/soltos
    na sidebar.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="css/awa-plp-final-polish.css"/>
        <remove src="css/awa-visual-qa-category.css"/>
        <!-- AWA vfix scope: PLP/category only -->
        <css src="css/awa-vfix-plp-search.css"/>
        <!-- Reabilitado: arquivo existe em pub/static; trava altura #mst_categorySearch em 44px. -->
        <css src="css/awa-plp-shell-final.css"/>
    </head>
    <body>
        <referenceBlock name="awa.header.impeccable.critical.global" remove="true"/>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.impeccable.category.critical.fixes"
                   template="Magento_Theme::html/awa-impeccable-category-critical-fixes-v4.phtml"
                   before="-"/>
        </referenceBlock>
        <!-- Performance: stack PLP dedicado (plp-promax + §89/91/93) — omitir audit global -->
        <referenceBlock name="awa.head.preload">
            <arguments>
                <argument name="awa_skip_audit_bundle" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="awa.impeccable.audit.uncached.global.v10" remove="true"/>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
        <referenceBlock name="category.image">
            <arguments>
                <argument name="visible_product_count_view_model" xsi:type="object">GrupoAwamotos\Theme\ViewModel\CategoryVisibleProductCount</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="awa.custom.global.js.loader">
            <arguments>
                <argument name="load_search_compat_js" xsi:type="boolean">true</argument>
                <argument name="load_home_category_compat_js" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>

        <!-- AWA - PLP extras: FAB filtros removido (audit #19); suggestions mantidas -->
        <referenceBlock name="awa.plp.filter.button" remove="true"/>
        <referenceContainer name="main.content">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.plp.suggestions"
                   template="Magento_Catalog::product/awa-plp-suggestions.phtml"
                   after="category.products.list"/>
        </referenceContainer>

    </body>
</page>
