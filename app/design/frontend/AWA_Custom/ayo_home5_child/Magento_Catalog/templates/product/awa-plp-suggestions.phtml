<?php
/**
 * AWA - PLP suggestions: did you mean + popular categories
 */
declare(strict_types=1);

$query = $block->getRequest()->getParam('q');
$popularCategories = [
    ['label' => 'Retrovisores', 'url' => '/retrovisores.html'],
    ['label' => 'Bagageiros', 'url' => '/bagageiros.html'],
    ['label' => 'Bauletos', 'url' => '/bauletos.html'],
    ['label' => 'Guidões', 'url' => '/guidoes.html'],
    ['label' => 'Manetes', 'url' => '/manoplas.html'],
    ['label' => 'Protetores de Carter', 'url' => '/protetores-de-carter.html'],
    ['label' => 'Pisca', 'url' => '/piscas.html'],
    ['label' => 'Faróis', 'url' => '/farois.html'],
    ['label' => 'Borrachas', 'url' => '/borrachas.html'],
    ['label' => 'Capas de Corrente', 'url' => '/capas-de-corrente.html'],
];
?>
<?php if ($query): ?>
<aside class="awa-plp-suggestions" aria-label="<?= $block->escapeHtmlAttr(__('Sugestões de navegação')) ?>">
    <div class="awa-plp-suggestions__container">
        <h3 class="awa-plp-suggestions__title">
