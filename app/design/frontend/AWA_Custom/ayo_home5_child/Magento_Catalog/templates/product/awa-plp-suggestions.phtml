        </p>
        <h3 class="awa-plp-suggestions__title">
            <?= $block->escapeHtml(__('Categorias populares')) ?>
        </h3>
        <ul class="awa-plp-suggestions__list" role="list">
            <?php foreach ($popularCategories as $cat): ?>
                <li class="awa-plp-suggestions__item">
                    <a href="<?= $block->escapeUrl($cat['url']) ?>"
                       class="awa-plp-suggestions__link"
                       title="<?= $block->escapeHtmlAttr($cat['label']) ?>">
                        <?= $block->escapeHtml($cat['label']) ?>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
