<?php
/**
 * AWA Motos - PDP Sticky ATC Bar (mobile)
 *
 * Sprint 3 (Mobile UX): barra fixa no rodape do mobile com
 * preco + botao "Adicionar" sempre visivel ao rolar.
 */
declare(strict_types=1);

$_product = $block->getProduct();
$_productId = (int) $_product->getId();
$_price = (float) $_product->getFinalPrice();
$_regularPrice = (float) $_product->getPrice();
$_hasDiscount = $_regularPrice > $_price;
$_currency = 'BRL';
$_symbol = 'R$';
$_isSaleable = $_product->isSaleable();
$_discountPercent = $_hasDiscount ? (int) round(100 - ($_price * 100 / $_regularPrice)) : 0;
$_installments = 10;
$_installmentPrice = $_price / $_installments;
?>
<div class="awa-pdp-sticky-atc"
     data-awa-sticky-atc
     data-product-id="<?= $block->escapeHtmlAttr($_productId) ?>"
     aria-label="<?= $block->escapeHtmlAttr(__('Adicionar ao carrinho')) ?>">

    <div class="awa-pdp-sticky-atc__price-block">
        <?php if ($_hasDiscount): ?>
        <span class="awa-pdp-sticky-atc__old-price">
            <?= $block->escapeHtml($_symbol . ' ' . number_format($_regularPrice, 2, ',', '.')) ?>
        </span>
        <?php endif; ?>
        <span class="awa-pdp-sticky-atc__price">
            <?= $block->escapeHtml($_symbol . ' ' . number_format($_price, 2, ',', '.')) ?>
        </span>
        <span class="awa-pdp-sticky-atc__installments">
            <?= $block->escapeHtml(__('ou ' . $_installments . 'x de ' . $_symbol . ' ' . number_format($_installmentPrice, 2, ',', '.') . ' sem juros')) ?>
        </span>
        <?php if ($_hasDiscount): ?>
        <span class="awa-pdp-sticky-atc__discount-badge">
            <?= $block->escapeHtml(__('-' . $_discountPercent . '%')) ?>
        </span>
        <?php endif; ?>
    </div>

    <div class="awa-pdp-sticky-atc__actions">
        <button type="button"
                class="awa-pdp-sticky-atc__wishlist"
                data-awa-sticky-atc-wishlist
                aria-label="<?= $block->escapeHtmlAttr(__('Adicionar aos favoritos')) ?>"
                disabled>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
        </button>

        <button type="submit"
                form="product_addtocart_form"
                class="awa-pdp-sticky-atc__atc action primary"
                data-awa-sticky-atc-atc
                <?= $_isSaleable ? '' : 'disabled' ?>
                aria-label="<?= $block->escapeHtmlAttr(__('Adicionar ' . $_product->getName() . ' ao carrinho')) ?>">
            <span class="awa-pdp-sticky-atc__atc-text">
                <?= $block->escapeHtml(__('Adicionar')) ?>
            </span>
        </button>
    </div>
</div>

