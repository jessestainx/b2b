<?php
/**
 * PDP secondary links — child theme override (addto)
 *
 * @var \Magento\Catalog\Block\Product\View $block
 */
declare(strict_types=1);

$_product = $block->getProduct();
/** @var \GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel|null $addtoViewModel */
$addtoViewModel = $block->getData('addto_view_model');
$_wishlistAllowed = false;
$_wishlistSubmitParams = '';
if ($addtoViewModel instanceof \GrupoAwamotos\Theme\ViewModel\BestsellerCardViewModel) {
    $_wishlistAllowed = $addtoViewModel->isWishlistAllowed();
    $_wishlistSubmitParams = $addtoViewModel->getWishlistAddParams($_product);
} else {
    /** @var \Magento\Wishlist\Helper\Data $wishlistHelper */
    $wishlistHelper = $this->helper(\Magento\Wishlist\Helper\Data::class);
    $_wishlistAllowed = $wishlistHelper->isAllow();
    $_wishlistSubmitParams = $wishlistHelper->getAddParams($_product);
}

/** @var \GrupoAwamotos\B2B\ViewModel\PdpGate|null $b2bGate */
$b2bGate = $block->getData('b2b_gate');
$_b2bCanViewPrices = $b2bGate instanceof \GrupoAwamotos\B2B\ViewModel\PdpGate
    ? $b2bGate->canViewPrices()
    : true;
?>

<?php if ($_b2bCanViewPrices && $_wishlistAllowed) : ?>
        <a href="#" title="<?= $this->escapeHtmlAttr(__('Add To Wishlist')) ?>"
                class="action towishlist wishlist-link"
                data-post='<?= $this->escapeHtmlAttr($_wishlistSubmitParams) ?>'
                data-action="add-to-wishlist"
                aria-label="<?= $this->escapeHtmlAttr(__('Add To Wishlist')) ?>"><i class="fa fa-heart" aria-hidden="true"></i><span class="awa-pdp-social-label"><?= $this->escapeHtml(__('Favoritos')) ?></span></a>
<?php endif; ?>
<?php /* compare desativado */ ?>
<script type="text/x-magento-init">
    {
        "body": {
            "addToWishlist": <?= /* @noEscape */ json_encode($block->getWishlistOptions()) ?>
        }
    }
</script>
