<?xml version="1.0"?>
<!--
  Mirasvit handle fallback: Controller\Page\View adds handle "search_landing_page".
  Same block name as search_landing_page_view / default — Magento merges, no duplicate.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Awa_CatalogFix::css/search-hint.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.search.hint"
                   template="Awa_CatalogFix::search-hint.phtml"
                   before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Awa\CatalogFix\Block\SearchHint</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
