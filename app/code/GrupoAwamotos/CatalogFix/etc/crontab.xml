<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Override Mirasvit: */1 bootstrap Magento a cada minuto era ~5% CPU contínuo -->
        <job name="mst_report_email"
             instance="Mirasvit\Report\Cron\EmailCron"
             method="execute">
            <schedule>5,35 * * * *</schedule>
        </job>
        <job name="grupoawamotos_catalogfix_sync_ofertas_category"
             instance="GrupoAwamotos\CatalogFix\Cron\SyncOfertasCategory"
             method="execute">
            <schedule>15 */6 * * *</schedule>
        </job>
    </group>
</config>
