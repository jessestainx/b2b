<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Repository interfaces -->
    <preference for="GrupoAwamotos\HelpCenter\Api\CategoryRepositoryInterface"
                type="GrupoAwamotos\HelpCenter\Model\CategoryRepository"/>

    <preference for="GrupoAwamotos\HelpCenter\Api\TopicRepositoryInterface"
                type="GrupoAwamotos\HelpCenter\Model\TopicRepository"/>

    <!-- Inject CommercialNavigation plugin to add Help tab without touching B2B module -->
    <type name="GrupoAwamotos\B2B\CommercialPanel\Block\Adminhtml\CommercialNavigation">
        <plugin name="grupoawamotos_helpcenter_add_help_tab"
                type="GrupoAwamotos\HelpCenter\Plugin\AddHelpTabPlugin"
                sortOrder="10"/>
    </type>

    <!-- Allow commercial/help route in CockpitAccessGuard via plugin -->
    <type name="GrupoAwamotos\B2B\CommercialPanel\Model\CockpitAccessGuard">
        <plugin name="grupoawamotos_helpcenter_guard"
                type="GrupoAwamotos\HelpCenter\Plugin\AllowHelpRoutePlugin"
                sortOrder="10"/>
    </type>

</config>
