<!-- Driver.js: carregado sob demanda apenas ao iniciar um tour -->
<script>
(function () {
    'use strict';

    /* Busca */
    var searchInput = document.getElementById('awa-hc-cockpit-search');
    var searchResults = document.getElementById('awa-hc-cockpit-results');
    if (searchInput && searchResults) {
        var searchTimer;
        searchInput.addEventListener('input', function () {
            clearTimeout(searchTimer);
            var q = searchInput.value.trim();
            if (q.length < 2) { searchResults.hidden = true; return; }
            searchTimer = setTimeout(function () {
                fetch(searchInput.dataset.searchUrl + '?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (d) { renderResults(d.topics || []); })
                    .catch(function () { searchResults.hidden = true; });
            }, 280);
        });
        document.addEventListener('click', function (e) {
            if (!searchResults.contains(e.target) && e.target !== searchInput) {
                searchResults.hidden = true;
            }
        });
    }

    function renderResults(topics) {
        searchResults.innerHTML = '';
        if (!topics.length) {
            searchResults.innerHTML = '<div class="awa-hc-cockpit__res-none">Nenhum resultado.</div>';
        } else {
            topics.forEach(function (t) {
                var a = document.createElement('a');
                a.href = t.url || ('#hc-topic-' + t.id);
                a.className = 'awa-hc-cockpit__res-item';
                a.setAttribute('role', 'option');
                a.innerHTML = '<span class="awa-hc-cockpit__res-title">' + esc(t.title) + '</span>'
                    + (t.summary ? '<span class="awa-hc-cockpit__res-sum">' + esc(t.summary) + '</span>' : '');
                searchResults.appendChild(a);
            });
        }
        searchResults.hidden = false;
    }

    function esc(s) {
        return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    /* Tours Driver.js — carrega script sob demanda */
    var DRIVER_SRC = '<?= $block->escapeJs($block->getViewFileUrl('GrupoAwamotos_HelpCenter::js/vendor/driver.iife.js')) ?>';
    var DRIVER_CSS = '<?= $block->escapeJs($block->getViewFileUrl('GrupoAwamotos_HelpCenter::css/driver.css')) ?>';
    var driverLoaded = false;
    var driverLoading = false;
    var pendingTour = null;

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.awa-hc-tour-btn');
        if (!btn) { return; }
        var steps;
        try { steps = JSON.parse(btn.dataset.tourSteps || '[]'); } catch (err) { return; }
        if (!steps.length) { return; }
        var title = btn.dataset.tourTitle || '';
        if (driverLoaded) {
            startTour(steps, title);
        } else {
            pendingTour = { steps: steps, title: title };
            loadDriver();
        }
    });

    function loadDriver() {
        if (driverLoading) { return; }
        driverLoading = true;
        /* CSS */
        if (!document.querySelector('link[data-awa-driver]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = DRIVER_CSS;
            link.setAttribute('data-awa-driver', '1');
            document.head.appendChild(link);
        }
        /* JS */
        var script = document.createElement('script');
        script.src = DRIVER_SRC;
        script.onload = function () {
            driverLoaded = true;
            driverLoading = false;
            if (pendingTour) {
                startTour(pendingTour.steps, pendingTour.title);
                pendingTour = null;
            }
        };
        script.onerror = function () {
            driverLoading = false;
            console.error('[AWA HelpCenter] Falha ao carregar Driver.js');
        };
        document.head.appendChild(script);
    }

    function startTour(steps, title) {
        /* Filtra seletores ausentes na página atual */
        var validSteps = steps.filter(function (s) {
            if (!s.element) { return true; }
            return document.querySelector(s.element) !== null;
        });
        if (!validSteps.length) {
            alert('Nenhum elemento do tour foi encontrado nesta tela. Navegue para a página indicada e tente novamente.');
            return;
        }
        var driver = window.driver.js.driver({
            showProgress: true,
            progressText: '{{current}} de {{total}}',
            nextBtnText: 'Próximo →',
            prevBtnText: '← Anterior',
            doneBtnText: 'Concluir',
            allowClose: true,
            steps: validSteps.map(function (s) {
                return {
                    element: s.element || undefined,
                    popover: {
                        title: s.title || title,
                        description: s.description || '',
                        side: s.side || 'bottom',
                        align: s.align || 'start',
                    }
                };
            })
        });
        driver.drive();
    }

    /* Âncora automática */
    if (location.hash && location.hash.startsWith('#hc-topic-')) {
        var el = document.querySelector(location.hash);
        if (el) {
            el.open = true;
            setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 150);
        }
    }
}());
</script>
