<?xml version="1.0"?>
<!--
    Injeta o painel de status B2B na página principal da conta do cliente
    (Minha Conta → Dashboard).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="GrupoAwamotos\B2B\Block\Account\Status"
                   name="b2b.account.status"
                   template="GrupoAwamotos_B2B::account/status.phtml"
                   before="dashboard"/>
        </referenceContainer>
    </body>
</page>
