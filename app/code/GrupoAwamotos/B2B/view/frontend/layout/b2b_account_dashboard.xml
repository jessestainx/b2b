<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="b2b_account_index"/>
    <body>
        <!-- Evita H1 duplicado: título vem do dashboard.phtml ("Painel B2B") -->
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="rexisml.recommendations" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
        <referenceBlock name="b2b.account.dashboard">
            <block class="GrupoAwamotos\ProductIntelligence\Block\Recommendations"
                   name="rexisml.b2b.recommendations"
                   template="GrupoAwamotos_ProductIntelligence::b2b/recommendations-widget.phtml">
                <arguments>
                    <argument name="limit" xsi:type="number">6</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceContainer name="page.top">
            <block class="Magento\Framework\View\Element\Template"
                   name="b2b.breadcrumbs"
                   template="GrupoAwamotos_B2B::navigation/breadcrumbs.phtml"
                   before="-">
                <arguments>
                    <argument name="page_title" xsi:type="string">Minha Conta B2B</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="b2b.shepherd.css"
                   template="GrupoAwamotos_B2B::head/shepherd-css.phtml"
                   before="b2b.dashboard.late.css"/>
        </referenceBlock>
    </body>
</page>
