<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <css src="GrupoAwamotos_B2B::css/account/pages-company.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="GrupoAwamotos\B2B\Block\Account\CompanyBlock"
                   name="b2b.company.index"
                   template="GrupoAwamotos_B2B::account/company.phtml"
                   cacheable="false"/>
        </referenceContainer>
        <referenceContainer name="page.top">
            <block class="Magento\Framework\View\Element\Template"
                   name="b2b.breadcrumbs"
                   template="GrupoAwamotos_B2B::navigation/breadcrumbs.phtml"
                   before="-">
                <arguments>
                    <argument name="page_title" xsi:type="string" translate="true">Dados da Empresa</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
