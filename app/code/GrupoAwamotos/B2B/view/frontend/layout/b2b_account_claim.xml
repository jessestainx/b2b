<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="empty"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="b2b_auth_shell"/>
    <head>
        <title>Ativar Acesso Online</title>
    </head>
    <body>
        <referenceBlock name="messages" remove="true"/>
        <referenceContainer name="main">
            <block class="GrupoAwamotos\B2B\Block\Account\Claim"
                   name="b2b.account.claim"
                   template="GrupoAwamotos_B2B::account/claim.phtml"
                   cacheable="false">
                <block class="GrupoAwamotos\B2B\Block\Account\AuthLogo"
                       name="auth.logo"
                       as="auth_logo"
                       template="GrupoAwamotos_B2B::html/auth-logo.phtml"/>
                <block class="GrupoAwamotos\B2B\Block\Account\SessionMessages"
                       name="b2b_claim_messages"
                       as="b2b_claim_messages"
                       template="GrupoAwamotos_B2B::account/login-messages.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
