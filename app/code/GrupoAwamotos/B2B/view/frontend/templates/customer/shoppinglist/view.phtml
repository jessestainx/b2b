<?php
/**
 * Shopping List View Template
 *
 * @var \GrupoAwamotos\B2B\Block\Customer\ShoppingList\ViewBlock $block
 * @var \GrupoAwamotos\B2B\ViewModel\ShoppingListViewModel $viewModel
 */
$viewModel = $block->getData('view_model');
$list = $block->getCurrentList();
$shoppingListViewConfig = [
    'messages' => [
        'qtyUpdateError' => (string) __('Erro ao atualizar quantidade.'),
    ],
];
?>
<?php if (!$list): ?>
    <div class="b2b-shoppinglist-view b2b-page-shell">
        <div class="awa-empty-state" role="status" aria-live="polite">
            <p class="awa-empty-state__title"><?= $block->escapeHtml(__('Lista de compras não encontrada')) ?></p>
            <p class="awa-empty-state__hint"><?= $block->escapeHtml(__('A lista pode ter sido excluída ou o link está desatualizado.')) ?></p>
            <div class="awa-empty-state__actions">
                <a href="<?= $block->escapeUrl($block->getBackUrl()) ?>" class="action primary">
                    <span><?= $block->escapeHtml(__('Voltar para Listas')) ?></span>
                </a>
            </div>
        </div>
    </div>
<?php else: ?>
    <?php $items = $viewModel->getListItems((int) $list->getId()); ?>
    <div class="b2b-shoppinglist-view b2b-page-shell"
         data-mage-init='<?= /* @noEscape */ json_encode(
             ['GrupoAwamotos_B2B/js/shoppinglist/view' => $shoppingListViewConfig],
             JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
         ) ?>'>
        <p class="b2b-live-region" data-role="shoppinglist-live" aria-live="polite"></p>
        <div class="b2b-section-header">
            <h1><?= $block->escapeHtml($list->getName()) ?></h1>
            <?php if ($list->getData('description')): ?>
                <p class="section-subtitle"><?= $block->escapeHtml($list->getData('description')) ?></p>
            <?php endif; ?>
            <?php if ($list->getData('is_default')): ?>
                <span class="default-badge"><?= $block->escapeHtml(__('Padrão')) ?></span>
            <?php endif; ?>
        </div>

        <div class="shoppinglist-top-actions">
            <a href="<?= $block->escapeUrl($block->getBackUrl()) ?>" class="action back">
                <span><?= $block->escapeHtml(__('Voltar para Listas')) ?></span>
            </a>
            <?php if ($items->getSize() > 0): ?>
                <form method="post" action="<?= $block->escapeUrl($block->getAddToCartUrl()) ?>" class="shoppinglist-add-all-form">
                    <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
                    <input type="hidden" name="id" value="<?= (int) $list->getId() ?>" />
                    <button type="submit" class="action primary add-all-cart">
                        <span><?= $block->escapeHtml(__('Adicionar Tudo ao Carrinho')) ?></span>
                    </button>
                </form>
            <?php endif; ?>
        </div>

        <!-- Configuração de Pedido Recorrente -->
        <?php if ($items->getSize() > 0): ?>
            <div class="recurring-config-section">
                <div class="recurring-header">
                    <strong><?= $block->escapeHtml(__('Pedido Recorrente')) ?></strong>
                </div>
                <form method="post" action="<?= $block->escapeUrl($block->getSetRecurringUrl()) ?>" class="recurring-form">
                    <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
                    <div class="recurring-toggle">
                        <label class="recurring-switch">
                            <input type="checkbox" name="is_recurring" value="1"
                                   id="recurring-toggle-input"
                                   <?= $list->getData('is_recurring') ? 'checked' : '' ?>
                                   data-role="recurring-toggle"
                                   aria-labelledby="recurring-toggle-label"
                                   aria-controls="recurring-options"
                                   aria-expanded="<?= $list->getData('is_recurring') ? 'true' : 'false' ?>" />
                            <span class="recurring-slider"></span>
                        </label>
                        <span id="recurring-toggle-label" class="toggle-label"><?= $block->escapeHtml(__('Ativar pedido automático')) ?></span>
                    </div>
                    <div class="recurring-options<?= !$list->getData('is_recurring') ? ' recurring-options--collapsed' : '' ?>"
                         id="recurring-options"
                         aria-hidden="<?= $list->getData('is_recurring') ? 'false' : 'true' ?>">
                        <label for="recurring_interval"><?= $block->escapeHtml(__('Repetir a cada')) ?></label>
                        <select name="recurring_interval" id="recurring_interval" class="recurring-select">
                            <?php
                            $intervals = [7 => '7 dias', 14 => '14 dias', 30 => '30 dias (mensal)', 60 => '60 dias', 90 => '90 dias (trimestral)'];
                            $currentInterval = (int) $list->getData('recurring_interval');
                            foreach ($intervals as $value => $label): ?>
                                <option value="<?= (int) $value ?>" <?= $currentInterval === $value ? 'selected' : '' ?>>
                                    <?= $block->escapeHtml(__($label)) ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                        <?php if ($list->getData('next_order_date')): ?>
                            <span class="next-order-info">
                                <?= $block->escapeHtml(__('Próximo pedido: %1', $block->formatDate((string) $list->getData('next_order_date')))) ?>
                            </span>
                        <?php endif; ?>
                    </div>
                    <button type="submit" class="action secondary save-recurring-btn">
                        <span><?= $block->escapeHtml(__('Salvar')) ?></span>
                    </button>
                </form>
            </div>
        <?php endif; ?>

        <?php if ($items->getSize() === 0): ?>
            <div class="awa-empty-state" role="status" aria-live="polite">
                <p class="awa-empty-state__title"><?= $block->escapeHtml(__('Esta lista está vazia')) ?></p>
                <p class="awa-empty-state__hint"><?= $block->escapeHtml(__('Navegue pelo catálogo para adicionar produtos.')) ?></p>
            </div>
        <?php else: ?>
            <div class="table-wrapper shoppinglist-items-table-wrapper">
                <table class="shoppinglist-items-table" aria-label="<?= $block->escapeHtmlAttr(__('Itens da lista de compras')) ?>">
                    <caption class="sr-only"><?= $block->escapeHtml(__('Itens da lista de compras')) ?></caption>
                    <thead>
                        <tr>
                            <th scope="col" class="col-image"><?= $block->escapeHtml(__('Produto')) ?></th>
                            <th scope="col" class="col-name"><?= $block->escapeHtml(__('Nome')) ?></th>
                            <th scope="col" class="col-sku"><?= $block->escapeHtml(__('SKU')) ?></th>
                            <th scope="col" class="col-price"><?= $block->escapeHtml(__('Preço')) ?></th>
                            <th scope="col" class="col-qty"><?= $block->escapeHtml(__('Qtd')) ?></th>
                            <th scope="col" class="col-subtotal"><?= $block->escapeHtml(__('Subtotal')) ?></th>
                            <th scope="col" class="col-actions"><?= $block->escapeHtml(__('Ações')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php $grandTotal = 0; ?>
                        <?php foreach ($items as $item): ?>
                            <?php
                            $product = $item->getProduct();
                            $lineTotal = $item->getLineTotal();
                            $grandTotal += $lineTotal;
                            $qty = (float) $item->getQty();
                            ?>
                            <tr class="item-row" data-item-id="<?= (int) $item->getId() ?>">
                                <td class="col-image" data-th="<?= $block->escapeHtmlAttr(__('Produto')) ?>">
                                    <?php if ($product): ?>
                                        <a href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>">
                                            <img src="<?= $block->escapeUrl($viewModel->getProductImageUrl($product)) ?>"
                                                 alt="<?= $block->escapeHtmlAttr($product->getName()) ?>"
                                                 width="80" height="80" loading="lazy" />
                                        </a>
                                    <?php else: ?>
                                        <span class="product-unavailable-img">—</span>
                                    <?php endif; ?>
                                </td>
                                <td class="col-name" data-th="<?= $block->escapeHtmlAttr(__('Nome')) ?>">
                                    <?php if ($product): ?>
                                        <a href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>">
                                            <?= $block->escapeHtml($product->getName()) ?>
                                        </a>
                                    <?php else: ?>
                                        <span class="product-unavailable"><?= $block->escapeHtml(__('Produto indisponível')) ?></span>
                                    <?php endif; ?>
                                </td>
                                <td class="col-sku" data-th="<?= $block->escapeHtmlAttr(__('SKU')) ?>">
                                    <?= $block->escapeHtml($item->getData('sku') ?: ($product ? $product->getSku() : '-')) ?>
                                </td>
                                <td class="col-price" data-th="<?= $block->escapeHtmlAttr(__('Preço')) ?>">
                                    <?php if ($product): ?>
                                        <?= /* @noEscape */ $viewModel->formatPrice((float) $product->getFinalPrice()) ?>
                                    <?php else: ?>
                                        —
                                    <?php endif; ?>
                                </td>
                                <td class="col-qty" data-th="<?= $block->escapeHtmlAttr(__('Qtd')) ?>">
                                    <input type="number"
                                           class="qty-input"
                                           name="qty"
                                           value="<?= (int) $qty ?>"
                                           min="1"
                                           inputmode="numeric"
                                           aria-label="<?= $block->escapeHtmlAttr(__('Quantidade do item SKU %1', $item->getData('sku') ?: ($product ? $product->getSku() : (string) $item->getId()))) ?>"
                                           data-item-id="<?= (int) $item->getId() ?>"
                                           data-update-url="<?= $block->escapeUrl($block->getUpdateItemUrl()) ?>" />
                                </td>
                                <td class="col-subtotal" data-th="<?= $block->escapeHtmlAttr(__('Subtotal')) ?>">
                                    <?= /* @noEscape */ $viewModel->formatPrice($lineTotal) ?>
                                </td>
                                <td class="col-actions" data-th="<?= $block->escapeHtmlAttr(__('Ações')) ?>">
                                    <form method="post"
                                          action="<?= $block->escapeUrl($block->getRemoveItemUrl((int) $item->getId())) ?>"
                                          id="shoppinglist-remove-item-form-<?= (int) $item->getId() ?>"
                                          class="shoppinglist-remove-item-form">
                                        <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
                                        <input type="hidden" name="item_id" value="<?= (int) $item->getId() ?>" />
                                        <input type="hidden" name="list_id" value="<?= (int) $list->getId() ?>" />
                                        <button type="button"
                                                class="action delete"
                                                title="<?= $block->escapeHtmlAttr(__('Remover')) ?>"
                                                data-confirm="<?= $block->escapeHtmlAttr(__('Remover este item da lista?')) ?>"
                                                data-target-form="shoppinglist-remove-item-form-<?= (int) $item->getId() ?>"
                                                aria-label="<?= $block->escapeHtmlAttr(__('Remover item %1 da lista', $item->getData('sku') ?: (string) $item->getId())) ?>">
                                            <span><?= $block->escapeHtml(__('Remover')) ?></span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="total-label"><?= $block->escapeHtml(__('Total Estimado')) ?></td>
                            <td colspan="2" class="total-value"><?= /* @noEscape */ $viewModel->formatPrice($grandTotal) ?></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="shoppinglist-bottom-actions">
                <form method="post" action="<?= $block->escapeUrl($block->getAddToCartUrl()) ?>" class="shoppinglist-add-all-form">
                    <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
                    <input type="hidden" name="id" value="<?= (int) $list->getId() ?>" />
                    <button type="submit" class="action primary add-all-cart">
                        <span><?= $block->escapeHtml(__('Adicionar Tudo ao Carrinho')) ?></span>
                    </button>
                </form>
                <a href="<?= $block->escapeUrl($block->getBackUrl()) ?>" class="action secondary">
                    <span><?= $block->escapeHtml(__('Voltar para Listas')) ?></span>
                </a>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>
