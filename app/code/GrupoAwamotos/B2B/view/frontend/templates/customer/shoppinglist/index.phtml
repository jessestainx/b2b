<?php
/**
 * Shopping List Index Template
 *
 * @var \GrupoAwamotos\B2B\Block\Customer\ShoppingList\ListBlock $block
 * @var \GrupoAwamotos\B2B\ViewModel\ShoppingListViewModel $viewModel
 */
$viewModel = $block->getData('view_model');
$lists = $viewModel->getCustomerLists();
?>
<!-- Dialog de confirmação de exclusão — reutilizado por todos os cards via JS -->
<dialog id="b2b-delete-list-dialog"
        class="b2b-confirm-dialog"
        aria-labelledby="b2b-delete-dialog-title"
        aria-describedby="b2b-delete-dialog-desc">
    <form method="dialog" class="b2b-confirm-dialog__inner">
        <svg class="b2b-confirm-dialog__icon" aria-hidden="true" focusable="false"
             xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
        </svg>
        <h2 id="b2b-delete-dialog-title" class="b2b-confirm-dialog__title">
            <?= $block->escapeHtml(__('Excluir lista de compras?')) ?>
        </h2>
        <p id="b2b-delete-dialog-desc" class="b2b-confirm-dialog__desc">
            <?= $block->escapeHtml(__('Os itens salvos serão removidos permanentemente. Esta ação não pode ser desfeita.')) ?>
        </p>
        <div class="b2b-confirm-dialog__actions">
            <button type="button"
                    id="b2b-delete-dialog-cancel"
                    class="action secondary b2b-confirm-dialog__btn-cancel"
                    value="cancel">
                <span><?= $block->escapeHtml(__('Cancelar')) ?></span>
            </button>
            <a id="b2b-delete-dialog-confirm"
               href="#"
               class="action delete b2b-confirm-dialog__btn-confirm"
               role="button">
                <span><?= $block->escapeHtml(__('Excluir lista')) ?></span>
            </a>
        </div>
    </form>
</dialog>

<div class="b2b-shoppinglist-index b2b-page-shell"
     data-mage-init='<?= /* @noEscape */ json_encode(['GrupoAwamotos_B2B/js/shoppinglist/index' => new \stdClass()]) ?>'>
    <div class="b2b-section-header">
        <h1><?= $block->escapeHtml(__('Listas de compras')) ?></h1>
        <p class="section-subtitle"><?= $block->escapeHtml(__('Salve conjuntos de peças e adicione tudo ao carrinho quando precisar.')) ?></p>
    </div>

    <div class="shoppinglist-actions-top">
        <button type="button" id="btn-create-list" class="action primary" title="<?= $block->escapeHtmlAttr(__('Criar lista')) ?>">
            <span><?= $block->escapeHtml(__('Criar lista')) ?></span>
        </button>
    </div>

    <!-- Create List Form (hidden by default) -->
    <div class="shoppinglist-create-form" id="create-list-form" style="display:none;">
        <form action="<?= $block->escapeUrl($block->getCreateUrl()) ?>" method="post"
              data-mage-init='{"validation":{}}'>
            <?= $block->getBlockHtml('formkey') ?>
            <div class="field required">
                <label for="list-name" class="label">
                    <span><?= $block->escapeHtml(__('Nome da Lista')) ?></span>
                </label>
                <div class="control">
                    <input type="text" id="list-name" name="name" required
                           data-validate="{required:true}"
                           placeholder="<?= $block->escapeHtmlAttr(__('Ex: Peças para revisão')) ?>" />
                </div>
            </div>
            <div class="field">
                <label for="list-description" class="label">
                    <span><?= $block->escapeHtml(__('Descrição (opcional)')) ?></span>
                </label>
                <div class="control">
                    <textarea id="list-description" name="description" rows="2"
                              placeholder="<?= $block->escapeHtmlAttr(__('Descrição da lista...')) ?>"></textarea>
                </div>
            </div>
            <div class="actions">
                <button type="submit" class="action primary">
                    <span><?= $block->escapeHtml(__('Criar lista')) ?></span>
                </button>
                <button type="button" class="action secondary" id="btn-cancel-create">
                    <span><?= $block->escapeHtml(__('Cancelar')) ?></span>
                </button>
            </div>
        </form>
    </div>

    <?php if ($lists->getSize() === 0): ?>
        <div class="message info empty">
            <span><?= $block->escapeHtml(__('Nenhuma lista criada. Use "Criar lista" para montar um conjunto fixo de peças.')) ?></span>
        </div>
    <?php else: ?>
        <div class="shoppinglist-grid">
            <?php foreach ($lists as $list): ?>
                <?php $itemCount = $viewModel->getItemsCount((int) $list->getId()); ?>
                <div class="shoppinglist-card">
                    <div class="card-header">
                        <h3 class="list-name">
                            <a href="<?= $block->escapeUrl($block->getViewUrl((int) $list->getId())) ?>">
                                <?= $block->escapeHtml($list->getName()) ?>
                            </a>
                        </h3>
                        <?php if ($list->getData('is_default')): ?>
                            <span class="default-badge"><?= $block->escapeHtml(__('Padrão')) ?></span>
                        <?php endif; ?>
                    </div>
                    <?php if ($list->getData('description')): ?>
                        <p class="list-description"><?= $block->escapeHtml($list->getData('description')) ?></p>
                    <?php endif; ?>
                    <div class="card-meta">
                        <span class="item-count"><?= (int) $itemCount ?> <?= $block->escapeHtml(__('itens')) ?></span>
                        <span class="list-total"><?= /* @noEscape */ $viewModel->getListTotal((int) $list->getId()) ?></span>
                    </div>
                    <div class="card-actions">
                        <a href="<?= $block->escapeUrl($block->getViewUrl((int) $list->getId())) ?>" class="action view">
                            <span><?= $block->escapeHtml(__('Ver Itens')) ?></span>
                        </a>
                        <a href="<?= $block->escapeUrl($block->getAddToCartUrl((int) $list->getId())) ?>" class="action primary add-to-cart">
                            <span><?= $block->escapeHtml(__('Adicionar ao carrinho')) ?></span>
                        </a>
                        <button type="button"
                                class="action delete action--trigger-delete-dialog"
                                data-delete-url="<?= $block->escapeUrl($block->getDeleteUrl((int) $list->getId())) ?>"
                                data-list-name="<?= $block->escapeHtmlAttr($list->getName()) ?>"
                                aria-haspopup="dialog">
                            <span><?= $block->escapeHtml(__('Excluir')) ?></span>
                        </button>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
