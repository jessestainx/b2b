<?php
/** @var \GrupoAwamotos\B2B\Block\Finance\PrintBoleto $block */
/** @var \Magento\Framework\Escaper $escaper */

$boleto = $block->getBoleto();
if ($boleto === null) {
    return;
}

$supported = !empty($boleto['supported']);
$barcodeSvg = $supported ? $block->getBarcodeSvgHtml() : '';
?>
<script>
/* Iframe do modal: esconde toolbar antes do paint (FPC pode ignorar ?embed=1). */
(function () {
    try {
        if (window.self !== window.top || /[?&]embed=1(?:&|$)/.test(window.location.search || '')) {
            document.documentElement.classList.add('b2b-print-boleto-embed');
        }
    } catch (e) {
        document.documentElement.classList.add('b2b-print-boleto-embed');
    }
})();
</script>
<style>
/* Critical: contraste do barcode no iframe/modal (fundo escuro do tema). */
.b2b-print-boleto__barcode {
    margin: 0 0 20px;
    padding: 16px 12px;
    background: #fff !important;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
}
.b2b-print-boleto__barcode svg {
    display: block;
    width: 100%;
    max-width: 760px;
    height: auto;
    background: #fff;
}
html.b2b-print-boleto-embed .b2b-print-boleto__toolbar,
.b2b-print-boleto.is-embed .b2b-print-boleto__toolbar {
    display: none !important;
}
html body#html-body.b2b-finance-printboleto,
html body#html-body.b2b-finance-printboleto .page-wrapper,
html body#html-body.b2b-finance-printboleto .page-main {
    background: #fff !important;
}
</style>
