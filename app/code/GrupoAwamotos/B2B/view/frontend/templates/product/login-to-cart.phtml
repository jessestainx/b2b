<?php
declare(strict_types=1);

/**
 * Template for B2B access restriction.
 * - Guests: shows login/register modal + replaces add-to-cart buttons
 * - Non-approved users: shows pending message + hides add-to-cart and checkout buttons
 */

/** @var \GrupoAwamotos\B2B\Block\LoginToCart $block */
/** @var \Magento\Framework\Escaper $escaper */

$isGuest = $block->isGuest();
$isPending = $block->isPendingApproval();
$isStrictB2B = $block->isStrictB2B();
$loginUrl = $escaper->escapeUrl($block->getLoginUrl());
$registerUrl = $escaper->escapeUrl($block->getRegisterUrl());
$b2bRegisterUrl = $escaper->escapeUrl($block->getB2bRegisterUrl());
$accountUrl = $escaper->escapeUrl($block->getAccountUrl());
$pendingMessage = $escaper->escapeHtml($block->getPendingMessage());

// Mode determines body class and JS behavior
$mode = $isGuest ? 'guest' : 'pending';
?>

<?php if ($isGuest): ?>
<!-- Modal de Login para Comprar (Visitante) -->
<div class="b2b-login-modal-overlay"
     id="b2b-login-modal"
     data-awa-component="b2b-login-modal"
     aria-hidden="true"
     hidden
     inert>
    <div class="b2b-login-modal" role="dialog" aria-modal="true" aria-labelledby="b2b-login-title" aria-describedby="b2b-login-desc" tabindex="-1">
        <div class="b2b-login-modal-header">
            <button type="button" class="b2b-login-modal-close" data-b2b-login-close aria-label="<?= $escaper->escapeHtmlAttr(__('Fechar')) ?>">&times;</button>
            <h3 id="b2b-login-title"><?= $escaper->escapeHtml($isStrictB2B ? __('Portal de Compra Empresarial') : __('Faça login para comprar')) ?></h3>
            <p id="b2b-login-desc"><?= $escaper->escapeHtml($isStrictB2B ? __('Cadastre sua empresa ou faça login para visualizar preços e comprar no atacado.') : __('Crie sua conta e aproveite nossas ofertas!')) ?></p>
        </div>
        <div class="b2b-login-modal-body">
            <div class="b2b-login-options">
                <?php if (!$isStrictB2B): ?>
                <a href="<?= /* @noEscape */ $registerUrl ?>" class="b2b-login-option">
                    <span class="b2b-login-option-title"><?= $escaper->escapeHtml(__('Cadastro Pessoa Física')) ?></span>
                    <span class="b2b-login-option-desc"><?= $escaper->escapeHtml(__('Para compras pessoais - rápido e fácil')) ?></span>
                </a>
                <?php endif; ?>

                <a href="<?= /* @noEscape */ $b2bRegisterUrl ?>" class="b2b-login-option b2b-primary">
                    <span class="b2b-login-option-title"><?= $escaper->escapeHtml(__('Cadastro Empresarial (B2B)')) ?></span>
                    <span class="b2b-login-option-desc"><?= $escaper->escapeHtml($isStrictB2B ? __('Para empresas, oficinas e revendas com CNPJ e condições especiais.') : __('Revendedores e empresas - descontos especiais!')) ?></span>
                </a>
            </div>

            <div class="b2b-login-already">
                <?= $escaper->escapeHtml(__('Já tem conta?')) ?> <a href="<?= $loginUrl ?>"><?= $escaper->escapeHtml(__('Fazer login')) ?></a>
            </div>
        </div>
    </div>
</div>
<?php endif; ?>

<?php if ($isPending): ?>
<!-- Banner de Conta Pendente (Logado mas n&atilde;o aprovado) -->
<div class="b2b-pending-banner"
     id="b2b-pending-banner"
     data-awa-component="b2b-pending-banner"
     role="status"
     aria-live="polite"
     hidden>
    <div class="b2b-pending-banner-inner">
        <svg class="b2b-pending-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <div class="b2b-pending-text">
            <strong><?= $escaper->escapeHtml(__('Conta pendente de aprovação')) ?></strong>
            <span><?= $pendingMessage ?></span>
        </div>
        <a href="<?= $accountUrl ?>" class="b2b-pending-account-link"><?= $escaper->escapeHtml(__('Minha Conta')) ?></a>
    </div>
</div>
<?php endif; ?>

<?php
$l2cConfig = [
    'mode' => $mode,
    'pdpButtonText' => (string) ($isGuest ? __('Entrar para Comprar') : __('Aguardando Aprovação')),
    'listingButtonText' => (string) ($isGuest ? __('Entrar para Comprar') : __('Aguardando Aprovação')),
];
$isHomePage = $block->getRequest()
    && $block->getRequest()->getFullActionName() === 'cms_index_index';
?>
<?php if ($isHomePage): ?>
<script type="application/json" id="awa-l2c-home-defer-json"><?= /* @noEscape */ json_encode(
    $l2cConfig,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP
) ?></script>
<script>
(function (w, d) {
    'use strict';
    var done = false;
    var events = ['pointerdown', 'keydown', 'touchstart'];
    function boot() {
        var el, cfg, s;
        if (done) { return; }
        if (typeof w.require !== 'function') {
            w.setTimeout(boot, 200);
            return;
        }
        done = true;
        events.forEach(function (n) { w.removeEventListener(n, boot, true); });
        el = d.getElementById('awa-l2c-home-defer-json');
        if (!el || !el.textContent) { return; }
        try { cfg = JSON.parse(el.textContent); } catch (e) { return; }
        s = d.createElement('script');
        s.type = 'text/x-magento-init';
        s.textContent = JSON.stringify({ '*': { 'GrupoAwamotos_B2B/js/login-to-cart': cfg } });
        d.body.appendChild(s);
        w.require(['mage/apply/main']);
    }
    events.forEach(function (n) {
        w.addEventListener(n, boot, { capture: true, passive: n !== 'keydown', once: true });
    });
})(window, document);
</script>
<?php else: ?>
<script type="text/x-magento-init">
{
    "*": {
        "GrupoAwamotos_B2B/js/login-to-cart": <?= /* @noEscape */ json_encode(
            $l2cConfig,
            JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP
        ) ?>
    }
}
</script>
<?php endif; ?>
