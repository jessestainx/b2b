<?php

declare(strict_types=1);

/**
 * ERP commerce fragment — suggested products + reorder list.
 *
 * @var \GrupoAwamotos\B2B\Block\Account\Dashboard $block
 */
$erpBlock = $block->getErpSuggestionsBlock();
$data = $block->getErpDashboardData();
$erpSuggestions = $data['suggestions'];
$erpReorder = $data['reorder'];
$hasCustomPriceList = $data['has_custom_price_list'];

if (!$erpBlock || (empty($erpSuggestions) && empty($erpReorder))) {
    return;
}
?>
<?php if (!empty($erpSuggestions)): ?>
    <div class="b2b-section erp-suggestions-section">
        <div class="section-header">
            <h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                <?= $block->escapeHtml(__('Produtos Sugeridos para Você')) ?>
            </h3>
            <a href="<?= $block->escapeUrl($block->getUrl('erpintegration/customer/suggestedcart')) ?>" class="view-all">
                <?= $block->escapeHtml(__('Ver Carrinho Sugerido')) ?> &rarr;
            </a>
        </div>
        <div class="erp-products-grid">
            <?php foreach ($erpSuggestions as $product): ?>
                <?php $hasMagento = !empty($product['magento']) && !empty($product['available_in_store']); ?>
                <div class="erp-product-card <?= $hasMagento ? '' : 'unavailable' ?>">
                    <?php if ($hasMagento && !empty($product['magento']['image'])): ?>
                        <div class="erp-product-image">
                            <a href="<?= $block->escapeUrl($erpBlock->getProductUrl($product)) ?>">
                                <img src="<?= $block->escapeUrl($product['magento']['image']) ?>"
                                     alt="<?= $block->escapeHtmlAttr($product['magento']['name'] ?? $product['descricao'] ?? '') ?>"
                                     loading="lazy" width="120" height="120" />
                            </a>
                        </div>
                    <?php else: ?>
                        <div class="erp-product-image placeholder">
                            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        </div>
                    <?php endif; ?>
                    <div class="erp-product-info">
                        <p class="erp-product-name">
                            <?php if ($hasMagento): ?>
                                <a href="<?= $block->escapeUrl($erpBlock->getProductUrl($product)) ?>">
                                    <?= $block->escapeHtml($product['magento']['name'] ?? $product['descricao'] ?? $product['codigo_material'] ?? '') ?>
                                </a>
                            <?php else: ?>
                                <?= $block->escapeHtml($product['descricao'] ?? $product['codigo_material'] ?? '') ?>
                            <?php endif; ?>
                        </p>
                        <span class="erp-product-sku"><?= $block->escapeHtml($product['codigo_material'] ?? '') ?></span>
                        <?php $customerPrice = $hasCustomPriceList ? $erpBlock->getCustomerPrice($product['codigo_material'] ?? '') : null; ?>
                        <?php if ($customerPrice !== null && $customerPrice > 0): ?>
                            <span class="erp-product-price customer-price"><?= /* @noEscape */ $erpBlock->formatPrice($customerPrice) ?></span>
                            <span class="erp-price-badge"><?= $block->escapeHtml(__('Seu preço')) ?></span>
                        <?php elseif ($hasMagento && !empty($product['magento']['final_price'])): ?>
                            <span class="erp-product-price"><?= /* @noEscape */ $block->formatPrice((float) $product['magento']['final_price']) ?></span>
                        <?php elseif (!empty($product['preco_medio'])): ?>
                            <span class="erp-product-price avg"><?= /* @noEscape */ $erpBlock->formatPrice((float) $product['preco_medio']) ?> <small><?= $block->escapeHtml(__('méd.')) ?></small></span>
                        <?php endif; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>

<?php if (!empty($erpReorder)): ?>
    <div class="b2b-section erp-reorder-section">
        <div class="section-header">
            <h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                <?= $block->escapeHtml(__('Hora de Repor')) ?>
            </h3>
            <a href="<?= $block->escapeUrl($block->getUrl('erpintegration/customer/suggestedcart')) ?>" class="view-all">
                <?= $block->escapeHtml(__('Ver Todos')) ?> &rarr;
            </a>
        </div>
        <div class="erp-reorder-list">
            <?php foreach ($erpReorder as $item): ?>
                <?php $hasMagento = !empty($item['magento']) && !empty($item['available_in_store']); ?>
                <div class="erp-reorder-item">
                    <div class="reorder-info">
                        <span class="reorder-name">
                            <?php if ($hasMagento): ?>
                                <a href="<?= $block->escapeUrl($erpBlock->getProductUrl($item)) ?>">
                                    <?= $block->escapeHtml($item['magento']['name'] ?? $item['descricao'] ?? '') ?>
                                </a>
                            <?php else: ?>
                                <?= $block->escapeHtml($item['descricao'] ?? $item['codigo_material'] ?? '') ?>
                            <?php endif; ?>
                        </span>
                        <span class="reorder-sku"><?= $block->escapeHtml($item['codigo_material'] ?? '') ?></span>
                    </div>
                    <?php $customerReorderPrice = $hasCustomPriceList ? $erpBlock->getCustomerPrice($item['codigo_material'] ?? '') : null; ?>
                    <?php if ($customerReorderPrice !== null && $customerReorderPrice > 0): ?>
                        <span class="reorder-price customer-price"><?= /* @noEscape */ $erpBlock->formatPrice($customerReorderPrice) ?></span>
                    <?php elseif ($hasMagento && !empty($item['magento']['final_price'])): ?>
                        <span class="reorder-price"><?= /* @noEscape */ $block->formatPrice((float) $item['magento']['final_price']) ?></span>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>
