<?php
/** @var \GrupoAwamotos\B2B\Block\Account\ErpOrders $block */
$page = $block->getCurrentPage();
$pageSize = $block->getPageSize();
$result = $block->getOrdersPage($page, $pageSize);
$orders = $result['items'];
$total = (int) $result['total_count'];
$totalPages = max(1, (int) ceil($total / $pageSize));
?>
<div class="b2b-erp-orders b2b-page-shell">
    <div class="b2b-section-header">
        <h1><?= $block->escapeHtml(__('Pedidos ERP')) ?></h1>
        <p class="section-subtitle"><?= $block->escapeHtml(__('Pedidos importados do ERP com status, itens e totais.')) ?></p>
    </div>

    <?php if (!$block->isAvailable()): ?>
        <div class="awa-empty-state" role="status">
            <p class="awa-empty-state__title"><?= $block->escapeHtml(__('Integração ERP indisponível')) ?></p>
            <p class="awa-empty-state__hint"><?= $block->escapeHtml(__('A sincronização com o ERP está indisponível. Tente de novo em alguns minutos ou fale com o suporte AWA.')) ?></p>
        </div>
    <?php elseif ($orders === []): ?>
        <div class="awa-empty-state" role="status">
            <p class="awa-empty-state__title"><?= $block->escapeHtml(__('Nenhum pedido ERP')) ?></p>
            <p class="awa-empty-state__hint"><?= $block->escapeHtml(__('Quando o ERP enviar pedidos para esta conta, o histórico aparece aqui.')) ?></p>
            <div class="awa-empty-state__actions">
                <a class="action primary" href="<?= $block->escapeUrl($block->getUrl('sales/order/history')) ?>">
                    <?= $block->escapeHtml(__('Ver pedidos na loja')) ?>
                </a>
            </div>
        </div>
    <?php else: ?>
        <div class="table-wrapper">
            <table class="data-table erp-orders-table">
                <caption class="sr-only"><?= $block->escapeHtml(__('Pedidos ERP')) ?></caption>
                <thead>
                    <tr>
                        <th><?= $block->escapeHtml(__('Pedido')) ?></th>
                        <th><?= $block->escapeHtml(__('Data')) ?></th>
                        <th><?= $block->escapeHtml(__('Status')) ?></th>
                        <th><?= $block->escapeHtml(__('Itens')) ?></th>
                        <th><?= $block->escapeHtml(__('Total')) ?></th>
                        <th><?= $block->escapeHtml(__('Ações')) ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($orders as $order): ?>
                    <tr>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Pedido')) ?>">#<?= $block->escapeHtml((string) ($order['pedido_id'] ?? '')) ?></td>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Data')) ?>"><?= $block->escapeHtml($block->formatErpDate($order['data_pedido'] ?? null)) ?></td>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Status')) ?>">
                            <?php $status = (string) ($order['status'] ?? ''); ?>
                            <span class="status-badge <?= $block->escapeHtmlAttr($block->getStatusClass($status)) ?>">
                                <?= $block->escapeHtml($block->getStatusLabel($status)) ?>
                            </span>
                        </td>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Itens')) ?>"><?= (int) ($order['qtd_itens'] ?? 0) ?></td>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Total')) ?>"><?= /* @noEscape */ $block->formatPrice((float) ($order['valor_total'] ?? 0)) ?></td>
                        <td data-th="<?= $block->escapeHtmlAttr(__('Ações')) ?>">
                            <a class="action view"
                               href="<?= $block->escapeUrl($block->getViewUrl((int) ($order['pedido_id'] ?? 0))) ?>">
                                <?= $block->escapeHtml(__('Detalhes')) ?>
                            </a>
                        </td>
                    </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>

        <?php if ($totalPages > 1): ?>
        <nav class="b2b-erp-orders__pager" aria-label="<?= $block->escapeHtmlAttr(__('Paginação')) ?>">
            <?php for ($p = 1; $p <= $totalPages; $p++): ?>
                <?php if ($p === $page): ?>
                    <span class="current"><?= (int) $p ?></span>
                <?php else: ?>
                    <a href="<?= $block->escapeUrl($block->getListUrl() . '?p=' . $p) ?>"><?= (int) $p ?></a>
                <?php endif; ?>
            <?php endfor; ?>
        </nav>
        <?php endif; ?>
    <?php endif; ?>
</div>
