<?php
/** @var \GrupoAwamotos\B2B\Block\Account\Orders $block */
/** @var \Magento\Framework\Escaper $escaper */
// $escaper is auto-injected by Magento 2.4+ template engine

$orders = $block->getOrders();
?>

<div class="account b2b-orders-page">

    <div class="b2b-dashboard-header">
        <div>
            <h1 class="dashboard-title page-title">
                <span><?= $escaper->escapeHtml(__('Meus Pedidos B2B')) ?></span>
            </h1>
        </div>
        <a href="<?= $escaper->escapeUrl($block->getUrl('b2b/account')) ?>"
           class="view-all">
            ← <?= $escaper->escapeHtml(__('Voltar para Conta B2B')) ?>
        </a>
    </div>

    <div class="column main">

        <?php if (empty($orders)): ?>
        <div class="b2b-section">
            <div class="empty-state-message">
                <p><?= $escaper->escapeHtml(__('Você ainda não realizou pedidos.')) ?></p>
                <a href="<?= $escaper->escapeUrl($block->getUrl('catalog')) ?>"
                   class="action primary">
                    <?= $escaper->escapeHtml(__('Explorar catálogo')) ?>
                </a>
            </div>
        </div>
        <?php else: ?>

        <div class="b2b-section">
            <div class="section-header">
                <h3><?= $escaper->escapeHtml(__('Histórico de Pedidos')) ?></h3>
            </div>
            <div class="b2b-table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th><?= $escaper->escapeHtml(__('Pedido')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Data')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Status')) ?></th>
                        <th class="col-total"><?= $escaper->escapeHtml(__('Total')) ?></th>
                        <th class="col-erp"><?= $escaper->escapeHtml(__('ERP Sectra')) ?></th>
                        <th class="col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($orders as $order):
                    /** @var \Magento\Sales\Model\Order $order */
                    $erp       = $block->getErpSync((int) $order->getId());
                    $erpStatus = $erp['sync_status'] ?? '';
                    $erpRef    = $erp['erp_reference'] ?? '';
                    $orderStatus = strtolower($order->getStatus());
                    $statusBadgeClass = match (true) {
                        in_array($orderStatus, ['pending', 'pending_payment']) => 'pending',
                        in_array($orderStatus, ['processing'])                 => 'processing',
                        in_array($orderStatus, ['complete'])                   => 'approved',
                        in_array($orderStatus, ['canceled', 'closed'])         => 'canceled',
                        default                                                 => '',
                    };
                ?>
                    <tr>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Pedido')) ?>">
                            <strong>#<?= $escaper->escapeHtml($order->getIncrementId()) ?></strong>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Data')) ?>"><?= $escaper->escapeHtml(
                            date('d/m/Y H:i', strtotime($order->getCreatedAt()))
                        ) ?></td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Status')) ?>">
                            <span class="status-badge <?= $escaper->escapeHtmlAttr($statusBadgeClass) ?>">
                                <?= $escaper->escapeHtml($order->getStatusLabel()) ?>
                            </span>
                        </td>
                        <td class="col-total" data-th="<?= $escaper->escapeHtmlAttr(__('Total')) ?>">
                            R$ <?= $escaper->escapeHtml(
                                number_format((float) $order->getGrandTotal(), 2, ',', '.')
                            ) ?>
                        </td>
                        <td class="col-erp" data-th="<?= $escaper->escapeHtmlAttr(__('ERP Sectra')) ?>">
                            <?php if ($erpStatus): ?>
                                <span class="status-badge <?= $escaper->escapeHtmlAttr(
                                    match ($erpStatus) {
                                        'synced'  => 'approved',
                                        'pending' => 'pending',
                                        'error'   => 'canceled',
                                        default   => '',
                                    }
                                ) ?>">
                                    <?= $escaper->escapeHtml($block->getErpStatusLabel($erpStatus)) ?>
                                </span>
                                <?php if ($erpRef): ?>
                                <div class="erp-ref">
                                    <?= $escaper->escapeHtml($erpRef) ?>
                                </div>
                                <?php endif; ?>
                            <?php else: ?>
                                <span class="erp-empty">—</span>
                            <?php endif; ?>
                        </td>
                        <td class="col-actions" data-th="<?= $escaper->escapeHtmlAttr(__('Ações')) ?>">
                            <a href="<?= $escaper->escapeUrl($block->getOrderUrl($order)) ?>"
                               class="checklist-action">
                                <?= $escaper->escapeHtml(__('Ver')) ?> →
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
            </div><!-- .b2b-table-scroll -->
        </div>

        <?php endif; ?>

    </div>
</div>
