$subscriptionActionsConfig = [
    'GrupoAwamotos_B2B/js/account/subscription-actions' => [
        'messages' => [
            'deleteTitle' => (string)__('Remover assinatura'),
            'deleteConfirm' => (string)__('Tem certeza de que deseja remover a assinatura "%1"?'),
            'deleteAction' => (string)__('Remover')
        ],
        'liveRegionSelector' => '[data-role="subscription-live"]'
    ]
];
?>
<div class="b2b-subscriptions-list b2b-page-shell"
     data-mage-init='<?= /* @noEscape */ json_encode(
         $subscriptionActionsConfig,
         JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
     ) ?>'>
    <div class="b2b-section-header">
        <h1><?= $block->escapeHtml(__('Assinaturas de pedidos')) ?></h1>
        <p class="section-subtitle"><?= $block->escapeHtml(__('Pedidos recorrentes gerados na frequência que você definir.')) ?></p>
        <div class="actions">
            <a href="<?= $block->escapeUrl($block->getUrl('b2b/subscription/create')) ?>" class="action primary">
                <?= $block->escapeHtml(__('Nova Assinatura')) ?>
            </a>
        </div>
    </div>
    <span class="b2b-live-region" data-role="subscription-live" aria-live="polite" aria-atomic="true"></span>

    <?php if ($subscriptions->getSize() > 0): ?>
        <div class="table-wrapper subscriptions-history">
            <table class="data table table-subscriptions-items history"
