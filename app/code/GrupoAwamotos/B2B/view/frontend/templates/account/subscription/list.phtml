                                   aria-label="<?= $block->escapeHtmlAttr(__('Editar assinatura %1', $subscription->getName())) ?>">
                                    <span><?= $block->escapeHtml(__('Editar')) ?></span>
                                </a>
                                <form method="post"
                                      action="<?= $block->escapeUrl($block->getDeleteUrl($subscription)) ?>"
                                      id="subscription-delete-form-<?= (int) $subscription->getId() ?>"
                                      class="subscription-delete-form">
                                    <?= $block->getBlockHtml('formkey') ?>
                                    <input type="hidden" name="id" value="<?= (int) $subscription->getId() ?>">
                                    <button type="button"
                                            class="action delete"
                                            data-role="delete-subscription"
                                            data-target-form="subscription-delete-form-<?= (int) $subscription->getId() ?>"
                                            data-subscription-id="<?= (int) $subscription->getId() ?>"
                                            data-subscription-name="<?= $block->escapeHtmlAttr($subscription->getName()) ?>"
                                            aria-label="<?= $block->escapeHtmlAttr(__('Remover assinatura %1', $subscription->getName())) ?>">
                                        <span><?= $block->escapeHtml(__('Remover')) ?></span>
                                    </button>
                                </form>
