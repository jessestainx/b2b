<script>
function approveCustomer() {
    if (confirm('Confirma a aprovação deste cliente B2B?')) {
        window.location.href = '<?= $block->escapeJs($block->getApproveUrl()) ?>';
    }
}

function showRejectModal() {
    document.getElementById('reject-modal').style.display = 'flex';
}

function closeRejectModal() {
    document.getElementById('reject-modal').style.display = 'none';
}

function saveErpFields() {
    var codErp    = document.getElementById('b2b-cod-erp').value.trim();
    var listPreco = document.getElementById('b2b-lista-preco').value.trim();
    var msg       = document.getElementById('b2b-erp-save-msg');

    fetch('<?= $block->escapeJs($block->getUrl('b2b/customer/saveErp')) ?>', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
        body: JSON.stringify({
            id:              <?= (int) $b2b->getId() ?>,
            cod_erp:         codErp,
            lista_preco_erp: listPreco,
            form_key:        window.FORM_KEY || ''
        })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            msg.style.display = 'inline';
            setTimeout(() => { msg.style.display = 'none'; }, 3000);
        } else {
            alert('Erro: ' + (data.message || 'Não foi possível salvar.'));
        }
    })
    .catch(() => alert('Erro de comunicação com o servidor.'));
}

function confirmReject() {
    var reason = document.getElementById('reject-reason').value.trim();
    if (!reason) {
        alert('Por favor informe o motivo da rejeição.');
        return;
    }
    window.location.href = '<?= $block->escapeJs($block->getRejectUrl()) ?>'
        + '&reason=' + encodeURIComponent(reason);
}
</script>
