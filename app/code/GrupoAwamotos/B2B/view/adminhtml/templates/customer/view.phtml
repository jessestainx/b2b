        <div style="margin-top:16px;display:flex;gap:10px;justify-content:flex-end;">
            <button onclick="closeRejectModal()"
                    style="padding:8px 20px;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;">
                Cancelar
            </button>
            <button onclick="confirmReject()"
                    style="padding:8px 20px;background:#c62828;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:700;">
