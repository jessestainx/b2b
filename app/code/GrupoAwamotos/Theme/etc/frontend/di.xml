<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
      Plugins de Response do storefront — NÃO registrar em etc/di.xml global.
      Rodar no adminhtml injeta CSS/JS de minicart/header e causa 404 AMD
      (js/awa-minicart-position no tema Magento/backend).
    -->
    <type name="GrupoAwamotos\Theme\Plugin\Response\PatchHomeHeaderHtmlPlugin">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</argument>
        </arguments>
    </type>

    <type name="GrupoAwamotos\Theme\Plugin\Response\OptimizeHeadStylesPlugin">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</argument>
        </arguments>
    </type>

    <type name="GrupoAwamotos\Theme\Plugin\Response\DeferHomeScriptsPlugin">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Page\Config\Renderer">
        <plugin name="grupoawamotos_theme_head_asset_rubik_async"
                type="GrupoAwamotos\Theme\Plugin\Framework\View\Page\Config\HeadAssetRendererPlugin"
                sortOrder="5"/>
    </type>

    <type name="Magento\Framework\HTTP\PhpEnvironment\Response">
        <plugin name="grupoawamotos_theme_patch_home_header_on_set_body"
                type="GrupoAwamotos\Theme\Plugin\Response\PatchHomeHeaderHtmlPlugin"
                sortOrder="50"/>
        <plugin name="grupoawamotos_theme_optimize_head_styles"
                type="GrupoAwamotos\Theme\Plugin\Response\OptimizeHeadStylesPlugin"
                sortOrder="998"/>
    </type>

    <type name="Magento\Framework\App\Response\Http">
        <plugin name="grupoawamotos_theme_defer_home_scripts"
                type="GrupoAwamotos\Theme\Plugin\Response\DeferHomeScriptsPlugin"
                sortOrder="15"/>
    </type>

    <type name="Mirasvit\SearchAutocomplete\Model\Result">
        <plugin name="grupoawamotos_theme_searchautocomplete_result_text_all"
                type="GrupoAwamotos\Theme\Plugin\Mirasvit\SearchAutocompleteResultPlugin"
                sortOrder="10"/>
    </type>
</config>
