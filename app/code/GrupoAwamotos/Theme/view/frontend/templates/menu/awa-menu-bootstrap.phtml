<?php
declare(strict_types=1);

/**
 * AWA Menu v2 bootstrap — flag, preflight mobile hamburger, lazy boot do controller.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
$layoutHandles = $block->getLayout() ? $block->getLayout()->getUpdate()->getHandles() : [];
$isCheckoutFocus = in_array('checkout_index_index', $layoutHandles, true)
    || in_array('onepagecheckout_index_index', $layoutHandles, true);
if ($isCheckoutFocus) {
    return;
}
$isHomePage = in_array('cms_index_index', $layoutHandles, true);
$controllerUrl = $block->getViewFileUrl('js/awa-menu-controller.dept-strip-r16.js');
$floatingCoreUrl = $block->getViewFileUrl('js/vendor/floating-ui.core.umd.min.js');
$floatingDomUrl = $block->getViewFileUrl('js/vendor/floating-ui.dom.umd.min.js');
$menuConfig = [
    'desktopBreakpoint' => 992,
    'hoverDelay' => 100,
    'limitShow' => 0,
];
$menuCssUrl = $block->getViewFileUrl('GrupoAwamotos_Theme::css/awa-menu-v2-dept-open-fix.css');
$runtimeUrl = $block->getViewFileUrl('GrupoAwamotos_Theme::js/awa-menu-bootstrap-runtime.dept-strip-r16.js');
$controllerPinUrl = preg_replace('/\.js$/i', '', $controllerUrl);
$runtimeConfig = [
    'controllerUrl' => $controllerUrl,
    'floatingCoreUrl' => $floatingCoreUrl,
    'floatingDomUrl' => $floatingDomUrl,
    'menuConfig' => $menuConfig,
    'isHome' => $isHomePage,
];
?>
<script>
window.__AWA_MENU_V2 = true; /* awa-dept-typography-strip-r16 */
(function (d, w) {
    'use strict';
    function stripDeptTriggerTypography() {
        d.querySelectorAll('[data-role="awa-vertical-menu-trigger"], .awa-vmenu-trigger-text').forEach(function (el) {
            ['font-size', 'font-weight', 'line-height'].forEach(function (prop) {
                el.style.removeProperty(prop);
            });
            if (!el.getAttribute('style')) {
                el.removeAttribute('style');
            }
        });
    }
    function bootStripGuard() {
        stripDeptTriggerTypography();
        if (!w.__awaDeptTypographyStripObserver) {
            // r44f: MutationObserver em documentElement no DCL compete com LCP na home.
            // Adia observe até load; strip pontual já rodou acima.
            var startObserver = function () {
                if (w.__awaDeptTypographyStripObserver) {
                    return;
                }
                w.__awaDeptTypographyStripObserver = new MutationObserver(function () {
                    stripDeptTriggerTypography();
                });
                w.__awaDeptTypographyStripObserver.observe(d.documentElement, {
                    subtree: true,
                    attributes: true,
                    attributeFilter: ['style']
                });
            };
            if (d.readyState === 'complete') {
                startObserver();
            } else {
                w.addEventListener('load', startObserver, { once: true });
            }
        }
    }
    if (d.readyState === 'loading') {
        d.addEventListener('DOMContentLoaded', bootStripGuard, { once: true });
    } else {
        bootStripGuard();
    }
    w.__awaStripDeptTriggerTypography = stripDeptTriggerTypography;

    /* CDN pode ignorar ?v= no path do runtime — fixa require path antes do defer boot. */
    var menuControllerPin = <?= /* @noEscape */ json_encode(
        $controllerPinUrl,
        JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
    ) ?>;
    function pinMenuControllerPath() {
        if (typeof w.require !== 'function' || typeof w.require.config !== 'function') {
            return false;
        }
        if (typeof w.require.undef === 'function') {
            w.require.undef('awa-menu-controller');
        }
        w.require.config({
            paths: {
                'awa-menu-controller': menuControllerPin
            }
        });
        return true;
    }
    if (!pinMenuControllerPath()) {
        var pinAttempts = 0;
        var pinTimer = w.setInterval(function () {
            pinAttempts += 1;
            if (pinMenuControllerPath() || pinAttempts > 80) {
                w.clearInterval(pinTimer);
            }
        }, 25);
    }
})(document, window);
</script>
<script type="application/json" id="awa-menu-bootstrap-config"><?= /* @noEscape */ json_encode(
    $runtimeConfig,
    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
) ?></script>
<script defer src="<?= $block->escapeUrl($runtimeUrl) ?>" id="awa-menu-bootstrap-runtime"></script>
<?php if (!$isHomePage): ?>
<script defer src="<?= $block->escapeUrl($floatingCoreUrl) ?>"></script>
<script defer src="<?= $block->escapeUrl($floatingDomUrl) ?>"></script>
<link rel="preload" href="<?= $block->escapeUrl($menuCssUrl) ?>" as="style"/>
<link rel="stylesheet" href="<?= $block->escapeUrl($menuCssUrl) ?>" id="awa-menu-v2-dept-open-fix"/>
<?php endif; ?>
