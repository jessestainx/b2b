<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
    </head>
    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.visual.bugfixes"
                   template="Magento_Theme::html/awa-visual-bugfixes.phtml"
                   after="-"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.inline.js.extract"
                   template="Magento_Theme::html/awa-inline-js-extract.phtml"
                   after="awa.visual.bugfixes"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.carousel.fixes"
                   template="Magento_Theme::html/awa-carousel-fixes.phtml"
                   after="awa.visual.bugfixes"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.view.transitions"
                   template="Magento_Theme::html/awa-view-transitions.phtml"
                   after="awa.inline.js.extract"/>
            <!-- AWA 2026-07-16: modo escuro desativado — bloco awa.dark.mode.toggle removido -->
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.pwa.install"
                   template="Magento_Theme::html/awa-pwa-install.phtml"
                   after="awa.view.transitions"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.ab.testing"
                   template="Magento_Theme::html/awa-ab-testing.phtml"
                   after="awa.pwa.install"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.rum"
                   template="Magento_Theme::html/awa-rum.phtml"
                   after="awa.ab.testing"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.push.notifications"
                   template="Magento_Theme::html/awa-push-notifications.phtml"
                   after="awa.rum"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.toast.system"
                   template="Magento_Theme::html/awa-toast-system.phtml"
                   after="awa.push.notifications"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="awa.scroll.reveal"
                   template="Magento_Theme::html/awa-scroll-reveal.phtml"
                   after="awa.toast.system"/>
        </referenceContainer>
    </body>
</page>
