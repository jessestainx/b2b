  "scm.countBadge": "off",
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "redhat.telemetry.enabled": false,
  "xml.server.vmargs": "-Xmx128m -Xms32m",
  "xml.server.preferBinary": true,
  "editor.tokenColorCustomizations": {},

  // === PERFORMANCE EXTRA (Remote SSH) ===
  // Inlay hints causam requests frequentes ao language server
  "editor.inlayHints.enabled": "off",
  // Parameter hints causam requests ao LSP em cada keystroke
  "editor.parameterHints.enabled": false,
  // Não mostrar decorações de problema no Explorer
  "problems.decorations.enabled": false,
  // Não calcular word highlights ao mover cursor
  "editor.occurrencesHighlight": "off",
  // Não renderizar whitespace (CPU painting)
  "editor.renderWhitespace": "none",
  // GPU acceleration desligada no Remote SSH
  "terminal.integrated.gpuAcceleration": "off",
  // Não baixar extensões localmente no Remote SSH
  "remote.downloadExtensionsLocally": false,

  // === UX IMPROVEMENTS ===
  // Evitar preview de arquivos ao navegar
  "workbench.editor.enablePreviewFromCodeNavigation": false,
  // Não mostrar dicas do workbench
  "workbench.tips.enabled": false,
  // Salvar automaticamente após 5s (evita perder trabalho)
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 5000,
  "workbench.editor.empty.hint": "hidden",
  "python.languageServer": "None",
  "python.analysis.indexing": false,
  "python.analysis.autoImportCompletions": false,

  // === AWA Cursor env opt 2026-08-02 ===
  "files.maxMemoryForLargeFilesMB": 64,
  "files.watcherInclude": [],
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  "extensions.ignoreRecommendations": true,
  "html.autoClosingTags": true,
  "cursor.cpp.enablePartialAccepts": true,
  "git.autorefresh": false,

  // Histórico local da IDE — evita crescer para GB e pressionar disco/I/O
  "workbench.localHistory.enabled": true,
  "workbench.localHistory.maxFileEntries": 10,
  "workbench.localHistory.maxFileSize": 128,
  "files.hotExit": "off",

  // === ULTRA-LEVE Remote SSH (2026-08-06) — só IDE, sem impacto Magento ===
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "none",
  "editor.matchBrackets": "near",
  "editor.folding": false,
  "editor.colorDecorators": false,
  "diffEditor.maxComputationTime": 2000,
  "diffEditor.renderSideBySide": false,
  "problems.showCurrentInStatus": false,
  "outline.collapseItems": "alwaysCollapse",
  "typescript.tsserver.maxTsServerMemory": 256,
  "javascript.validate.enable": false,
  "css.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "npm.enableScriptExplorer": false,
  "references.preferredLocation": "view"
}
