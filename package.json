{
  "name": "awa-motos",
  "version": "1.0.0",
  "description": "AWA Motos \u2014 Magento 2 storefront",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "audit:home": "lhci autorun --collect.url=https://awamotos.com/ --collect.numberOfRuns=1",
    "audit:pwa": "lhci autorun --collect.url=https://pwa.awamotos.com/ --collect.numberOfRuns=1",
    "deploy:check": "bash scripts/deploy/pre-deploy.sh",
    "health": "bash scripts/monitoring/health-check.sh",
    "backup": "bash scripts/backup/magento-backup.sh",
    "warm": "bash scripts/warmup/warm-cache.sh",
    "pw:qa-safe": "bash scripts/playwright-qa-safe.sh"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "lighthouse": "^11.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
